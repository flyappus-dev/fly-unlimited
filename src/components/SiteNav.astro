---
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/explore/", label: "Explore" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/livetime/", label: "LiveTime" },
  { href: "/info/", label: "About" },
];

const activeFor = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(href);
---

<header class="siteNav">
  <div class="siteNav__inner">
    <a class="siteNav__brand" href="/" aria-label="FLY Unlimited home">
      <img src="/logo-alt.png" alt="FLY home" />
    </a>

    <nav class="siteNav__desktop" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          class:list={["siteNav__link", activeFor(link.href) && "is-active"]}
          href={link.href}
          aria-current={activeFor(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="siteNav__actions">
      <a
        class="siteNav__download"
        href={appStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
      </a>

      <details class="siteNav__mobile">
        <summary aria-label="Open navigation">
          <span></span><span></span>
        </summary>

        <div class="siteNav__mobilePanel">
          {links.map((link) => (
            <a
              class:list={["siteNav__mobileLink", activeFor(link.href) && "is-active"]}
              href={link.href}
              aria-current={activeFor(link.href) ? "page" : undefined}
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))}

          <a
            class="siteNav__mobileDownload"
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
<div class="siteNav__spacer" aria-hidden="true"></div>

<style>
  .siteNav{
    position:fixed;
    inset:0 0 auto;
    z-index:200;
    padding-top:env(safe-area-inset-top,0px);
    background:rgba(255,255,255,.88);
    border-bottom:1px solid rgba(10,10,10,.08);
    backdrop-filter:blur(22px) saturate(145%);
    -webkit-backdrop-filter:blur(22px) saturate(145%);
  }

  .siteNav__spacer{
    height:calc(56px + env(safe-area-inset-top,0px));
  }

  :global(body.siteShellPage){
    padding-top:0 !important;
  }

  .siteNav__inner{
    width:min(calc(100% - 32px),1240px);
    min-height:56px;
    margin:0 auto;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    gap:24px;
  }

  .siteNav__brand{
    width:max-content;
    display:inline-flex;
    align-items:center;
    gap:9px;
    color:#0a0a0a;
    text-decoration:none;
  }

  .siteNav__brand img{
    width:auto;
    height:18px;
    display:block;
    object-fit:contain;
    border-radius:0;
  }

  .siteNav__desktop{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:2px;
  }

  .siteNav__link{
    position:relative;
    min-height:34px;
    padding:0 12px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border-radius:999px;
    color:rgba(10,10,10,.62);
    font-size:11.5px;
    font-weight:680;
    letter-spacing:-.01em;
    text-decoration:none;
    transition:background .18s ease,color .18s ease;
  }

  .siteNav__link:hover{
    background:rgba(10,10,10,.045);
    color:#0a0a0a;
  }

  .siteNav__link.is-active{
    color:#0a0a0a;
    background:rgba(10,10,10,.065);
  }

  .siteNav__actions{
    display:flex;
    justify-content:flex-end;
    align-items:center;
    gap:10px;
  }

  .siteNav__download{
    min-height:34px;
    padding:0 15px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border-radius:999px;
    background:#0a0a0a;
    color:#fff;
    font-size:12px;
    font-weight:750;
    text-decoration:none;
    transition:transform .18s ease,background .18s ease;
  }

  .siteNav__download:hover{
    transform:translateY(-1px);
    background:#242424;
  }

  .siteNav__mobile{
    display:none;
    position:relative;
  }

  .siteNav__mobile summary{
    width:40px;
    height:40px;
    list-style:none;
    border-radius:999px;
    background:#f1f1f1;
    display:grid;
    place-content:center;
    gap:5px;
    cursor:pointer;
  }

  .siteNav__mobile summary::-webkit-details-marker{display:none}

  .siteNav__mobile summary span{
    width:16px;
    height:1.5px;
    display:block;
    background:#111;
    border-radius:999px;
  }

  .siteNav__mobilePanel{
    position:absolute;
    top:48px;
    right:0;
    width:min(310px,calc(100vw - 36px));
    padding:10px;
    border:1px solid rgba(10,10,10,.08);
    border-radius:18px;
    background:rgba(255,255,255,.98);
    box-shadow:0 22px 60px rgba(0,0,0,.14);
  }

  .siteNav__mobileLink{
    min-height:48px;
    padding:0 12px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    color:#111;
    font-size:15px;
    font-weight:700;
    text-decoration:none;
  }

  .siteNav__mobileLink.is-active{
    background:#f4f4f4;
  }

  .siteNav__mobileDownload{
    min-height:48px;
    margin-top:8px;
    padding:0 14px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:12px;
    background:#0a0a0a;
    color:#fff;
    font-size:14px;
    font-weight:750;
    text-decoration:none;
  }

  @media(max-width:760px){
    .siteNav__inner{
      width:min(calc(100% - 24px),1240px);
      grid-template-columns:1fr auto;
    }

    .siteNav__desktop,
    .siteNav__download{
      display:none;
    }

    .siteNav__mobile{
      display:block;
    }
  }

  @media(prefers-reduced-motion:reduce){
    .siteNav__link,
    .siteNav__download{transition:none}
  }
</style>
