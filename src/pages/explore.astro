---
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const siteName = "FLY Unlimited";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";

const ways = [
  {
    number: "01",
    title: "Services",
    description: "Find someone who can do what you need — from creative work to hands-on help.",
    example: "Photograph my event Friday night.",
    icon: "service",
  },
  {
    number: "02",
    title: "Delivery",
    description: "Put a pickup and destination into one FLY and keep the handoff connected.",
    example: "Pick this up and bring it downtown.",
    icon: "delivery",
  },
  {
    number: "03",
    title: "Transport",
    description: "Go from here to there, return later, or coordinate a route with multiple stops.",
    example: "Take me there and bring me back later.",
    icon: "transport",
  },
  {
    number: "04",
    title: "Stays",
    description: "Find a place that fits the moment without leaving the network around you.",
    example: "I need a place for the weekend.",
    icon: "stay",
  },
  {
    number: "05",
    title: "Rentals",
    description: "Find access to something you need without turning the request into a purchase.",
    example: "I need a camera for Saturday.",
    icon: "rental",
  },
  {
    number: "06",
    title: "Collabs",
    description: "Find people to build, create, perform, organize, or make something happen with.",
    example: "Help me build the launch.",
    icon: "collab",
  },
];

const examples = [
  "I need a photographer tomorrow night.",
  "Pick this up and deliver it to me.",
  "Take me to the airport Friday morning.",
  "Looking for someone to help shoot a campaign.",
  "I need somewhere to stay this weekend.",
  "Looking to rent equipment for an event.",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Explore FLY • {siteName}</title>
    <meta
      name="description"
      content="Explore the many ways to FLY — services, delivery, transport, stays, rentals, collaborations, and whatever else real life needs."
    />
    <meta name="theme-color" content="#ffffff" />
      <link rel="stylesheet" href="/fly-home-ask-how-compact-v24.css" />
    <link rel="stylesheet" href="/how-category-profiles-v60.css" />
    <link rel="stylesheet" href="/how-steps-types-separation-v67.css" />
    <link rel="stylesheet" href="/fly-refinement-v1.css" />
</head>

  <body class="siteShellPage page-explore">
    <SiteNav />

    <main>
      <section class="hero" aria-labelledby="explore-title">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">Explore FLY</p>
            <h1 id="explore-title">
              <span class="hero__primary">Whatever you need.</span>
              <span class="hero__secondary">Start with the ask.</span>
            </h1>
            <p class="hero__lead">
              FLY is one marketplace for the things people need, the things people can do,
              and the opportunities already moving around them.
            </p>

            <div class="hero__actions">
              <a
                class="button button--dark"
                href={appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
              </a>
              <a class="button button--light" href="/how-it-works/">See how FLY works</a>
            </div>
          </div>

          <div class="askStage" aria-label="Examples of things you can ask for on FLY">
            <div class="askStage__card">
              <div class="askStage__top">
                <span>ASK</span>
                <span aria-hidden="true">+</span>
              </div>

              <p class="askStage__prompt">What do you need?</p>

              <div class="askStage__field">
                <span>I need</span>
                <strong>event photos tonight.</strong>
              </div>

              <div class="askStage__meta">
                <span>When</span>
                <span>Where</span>
                <span>Details</span>
              </div>
            </div>

            <span class="example example--one">Event photos</span>
            <span class="example example--two">A ride</span>
            <span class="example example--three">Miami Design District</span>
            <span class="example example--four">Friday 8 PM</span>
            <span class="example example--five">Details attached</span>
          </div>
        </div>
      </section>

      <section class="manifesto" aria-labelledby="manifesto-title">
        <div class="manifesto__inner">
          <p class="eyebrow">One network</p>
          <h2 id="manifesto-title">Real life does not fit inside one category.</h2>
          <p>
            Sometimes you need a person. Sometimes a place. Sometimes a ride,
            a delivery, a rental, or someone to build something with. FLY starts
            with the need and gives it somewhere to go.
          </p>
        </div>
      </section>

      <section class="exploreWaysMerged" id="ways" aria-labelledby="explore-ways-title">
        <div class="exploreWaysMerged__inner">
          <div class="exploreWaysMerged__head">
            <div>
              <p class="eyebrow">Ways to use FLY</p>
              <h2 id="explore-ways-title">Real life has more than one shape.</h2>
            </div>
            <p>
              Start with what you need. FLY can support different kinds of
              requests without making you begin in a different app every time.
            </p>
          </div>

          <div class="exploreWaysMerged__grid">
            <article class="exploreWay">
              <span>01</span><div><h3>Services</h3><p>Find someone who can do the work you need.</p></div>
              <strong>“Photograph my event Friday night.”</strong>
            </article>
            <article class="exploreWay">
              <span>02</span><div><h3>Delivery</h3><p>Move something from pickup to destination.</p></div>
              <strong>“Pick this up and bring it downtown.”</strong>
            </article>
            <article class="exploreWay exploreWay--featured">
              <span>03</span><div><h3>Rides &amp; Transport</h3><p>One-way, return, scheduled or multi-stop transportation.</p></div>
              <strong>“Take me there, then bring me back two hours later.”</strong>
            </article>
            <article class="exploreWay">
              <span>04</span><div><h3>Stays</h3><p>Find somewhere that fits the moment.</p></div>
              <strong>“I need a place for the weekend.”</strong>
            </article>
            <article class="exploreWay">
              <span>05</span><div><h3>Rentals</h3><p>Get temporary access to something you need.</p></div>
              <strong>“I need a camera for Saturday.”</strong>
            </article>
            <article class="exploreWay">
              <span>06</span><div><h3>Collabs</h3><p>Build, create, organize or make something happen together.</p></div>
              <strong>“Help me build the launch.”</strong>
            </article>
            <article class="exploreWay exploreWay--wide">
              <span>07</span><div><h3>Purchase &amp; sourcing</h3><p>Find something you want to buy or source through the same marketplace.</p></div>
              <strong>“Looking for tickets for Saturday night.”</strong>
            </article>
          </div>
        </div>
      </section>

<section class="exploreCategoryHub" aria-label="Explore FLY categories">
        <div class="exploreCategoryHub__inner">
          <aside class="categoryBannerExact" aria-labelledby="category-banner-title">
          <div class="categoryBannerExact__copy">
            <h3 id="category-banner-title">Discover Categories</h3>

            <p>
              Categories help your Ask reach the right people and opportunities.
              Something different? Start with what you need.
            </p>

            <a href="/how-it-works/#ask" class="categoryBannerExact__link">
              Ask first
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="categoryBannerExact__rail" aria-label="Popular FLY categories">

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--home">
                <img src="/flyhome.svg" alt="" aria-hidden="true" />
              </div>
              <span>For Home</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--events">
                <img src="/category-icons/Events.svg" alt="" aria-hidden="true" />
              </div>
              <span>Events</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--business">
                <img src="/category-icons/Business.svg" alt="" aria-hidden="true" />
              </div>
              <span>Business</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--photo">
                <img src="/category-icons/Photo.svg" alt="" aria-hidden="true" />
              </div>
              <span>Photo &amp; Video</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--technology">
                <img src="/category-icons/Technology.svg" alt="" aria-hidden="true" />
              </div>
              <span>Technology</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--collabs">
                <img src="/category-icons/Collabs.svg" alt="" aria-hidden="true" />
              </div>
              <span>Collabs</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--pets">
                <img src="/category-icons/Pets.svg" alt="" aria-hidden="true" />
              </div>
              <span>For Pets</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--gaming">
                <img src="/category-icons/Gaming.svg" alt="" aria-hidden="true" />
              </div>
              <span>Gaming</span>
            </div>

            <div class="categoryBannerExact__item">
              <div class="categoryBannerExact__icon categoryBannerExact__icon--education">
                <img src="/category-icons/Education.svg" alt="" aria-hidden="true" />
              </div>
              <span>Education</span>
            </div>

          </div>
        </aside>
        </div>
      </section>

<section class="marketMixV24 stepsTypesStandaloneV67" id="fly-types" aria-labelledby="market-mix-v67-title">
        <div class="marketMixV24__inner">
          <h2 class="marketMixV24__title" id="market-mix-v67-title">One category. Many ways to FLY.</h2>
          <p class="marketMixV24__lead">Once your Ask has a category, that same category can support different ways to make it happen: Service, Rental, Delivery, or Purchase.</p>
          <div class="marketMixV24__event"><span class="marketMixV24__eventIcon" aria-hidden="true"><img src="/category-icons/Events.svg" alt="" /></span><span class="marketMixV24__eventText"><small>Category</small><strong>Events</strong></span></div>
          <div class="marketMixV24__branch" aria-hidden="true"></div>
          <div class="marketMixV24__examples">
            <article class="marketMixV24__example"><div class="marketMixV24__type"><span class="marketMixV24__typeIcon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="11" rx="2"></rect><path d="M9 7V5h6v2M5 11h14"></path></svg></span><span>Service</span></div><div class="marketMixV60__profile"><img class="marketMixV60__avatar" src="/campaign/how-profile-service-v60.jpg" alt="" /><span class="marketMixV60__identity"><strong class="marketMixV60__name">Ethan Cole</strong><small class="marketMixV60__username">@ethancole</small></span></div><p class="marketMixV24__ask">Need a photographer for our wedding ceremony and reception.</p></article>
            <article class="marketMixV24__example"><div class="marketMixV24__type"><span class="marketMixV24__typeIcon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="8" cy="12" r="4"></circle><path d="M12 12h7M16 12v3M19 12v2"></path></svg></span><span>Rental</span></div><div class="marketMixV60__profile"><img class="marketMixV60__avatar" src="/campaign/how-profile-rental-v60.jpg" alt="" /><span class="marketMixV60__identity"><strong class="marketMixV60__name">Leo Martinez</strong><small class="marketMixV60__username">@leo.m</small></span></div><p class="marketMixV24__ask">Need speakers and lighting for a small live concert this weekend.</p></article>
            <article class="marketMixV24__example"><div class="marketMixV24__type"><span class="marketMixV24__typeIcon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="1.5"></circle><circle cx="18" cy="18" r="1.5"></circle></svg></span><span>Delivery</span></div><div class="marketMixV60__profile"><img class="marketMixV60__avatar" src="/campaign/how-profile-delivery-v60.jpg" alt="" /><span class="marketMixV60__identity"><strong class="marketMixV60__name">Sofia Grant</strong><small class="marketMixV60__username">@sofiagrant</small></span></div><p class="marketMixV24__ask">Need flowers delivered to the wedding venue before the ceremony.</p></article>
            <article class="marketMixV24__example"><div class="marketMixV24__type"><span class="marketMixV24__typeIcon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg></span><span>Purchase</span></div><div class="marketMixV60__profile"><img class="marketMixV60__avatar" src="/campaign/how-profile-purchase-v60.jpg" alt="" /><span class="marketMixV60__identity"><strong class="marketMixV60__name">Jordan Blake</strong><small class="marketMixV60__username">@jordanb</small></span></div><p class="marketMixV24__ask">Looking for Smashing Pumpkins tickets.</p></article>
          </div>
          <p class="marketMixV24__close">The category stays the same; the FLY type changes how the request is fulfilled.</p>
        </div>
      </section>



      <section class="exploreFeatures" id="features" aria-labelledby="explore-features-title">
        <div class="exploreFeatures__inner">
          <div class="exploreFeatures__head">
            <p class="eyebrow">More than the match</p>
            <h2 id="explore-features-title">FLY keeps going after you connect.</h2>
            <p>
              The marketplace is only the beginning. FLY also gives the request
              a place to move, get funded when appropriate, and become part of a
              network you can return to.
            </p>
          </div>

          <div class="exploreFeatures__grid">
            <a class="featureStory featureStory--dark" href="/livetime/">
              <div class="featureStory__top"><span>01</span><span>Explore LiveTime ↗</span></div>
              <div class="featureStory__copy">
                <p>LiveTime</p><h3>Where the FLY happens.</h3>
                <span>Keep the plan, progress, files, routes, updates and completion connected while the FLY is happening.</span>
              </div>
              <div class="featureStory__flow" aria-hidden="true"><i>✓</i><b></b><i class="active">2</i><b></b><i>3</i><b></b><i>4</i></div>
            </a>

            <article class="featureStory featureStory--pay">
              <div class="featureStory__top"><span>02</span><span>Early Pay</span></div>
              <div class="featureStory__copy">
                <p>Early Pay</p><h3>Some FLYs need money before they are finished.</h3>
                <span>When Early Pay is available for a FLY, eligible funds can be made available earlier so the FLY can keep moving. Availability and eligibility may vary.</span>
              </div>
              <div class="featureStory__money" aria-hidden="true"><span>$</span><div><small>FLY funded</small><strong>Earlier access</strong></div></div>
            </article>

            <article class="featureStory featureStory--network">
              <div class="featureStory__top"><span>03</span><span>FLY Network</span></div>
              <div class="featureStory__copy">
                <p>FLY Network</p><h3>One FLY can become a connection.</h3>
                <span>Profiles, people you work with and repeat interactions can become part of the network around you instead of disappearing after one transaction.</span>
              </div>
              <div class="featureStory__people" aria-hidden="true">
                <img src="/campaign/how-profile-service-v60.jpg" alt="" />
                <img src="/campaign/how-profile-rental-v60.jpg" alt="" />
                <img src="/campaign/how-profile-delivery-v60.jpg" alt="" />
                <img src="/campaign/how-profile-purchase-v60.jpg" alt="" />
              </div>
            </article>
          </div>
        </div>
      </section>
<section class="examples" aria-labelledby="examples-title">
        <div class="examples__inner">
          <div class="examples__copy">
            <p class="eyebrow">What does that look like?</p>
            <h2 id="examples-title">The marketplace starts with a sentence.</h2>
            <p>
              You do not have to think like a marketplace operator. Start with what
              you actually need and make the request clear.
            </p>
          </div>

          <div class="examples__rail" aria-label="Example FLY asks">
            {examples.map((example, index) => (
              <article class="exampleAsk">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{example}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="logic" aria-labelledby="logic-title">
        <div class="logic__inner">
          <div class="logic__heading">
            <p class="eyebrow">Simple on the surface</p>
            <h2 id="logic-title">The ask comes first. FLY organizes what happens next.</h2>
          </div>

          <div class="logic__grid">
            <article>
              <span>01</span>
              <h3>What it is about</h3>
              <p>
                Categories make a FLY easier to understand and easier for the right
                people to discover.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>How it needs to happen</h3>
              <p>
                The experience can adapt to the job itself — work, delivery,
                transportation, a stay, a rental, a collaboration, and more.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Who fits</h3>
              <p>
                People discover the FLY, apply when it fits, and the host chooses
                who they want to move forward with.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="handoff" aria-labelledby="handoff-title">
        <div class="handoff__inner">
          <div class="handoff__copy">
            <p class="eyebrow">From ask to done</p>
            <h2 id="handoff-title">Finding someone is only the beginning.</h2>
            <p>
              Once a FLY connects, the work should not disappear into scattered
              texts, screenshots, payment apps, and loose details. FLY keeps the
              next steps connected to the request.
            </p>
            <a href="/how-it-works/">See the full flow <span aria-hidden="true">→</span></a>
          </div>

          <div class="handoff__flow" aria-label="FLY flow">
            <div><span>01</span><strong>Ask</strong></div>
            <div><span>02</span><strong>Discover</strong></div>
            <div><span>03</span><strong>Connect</strong></div>
            <div><span>04</span><strong>LiveTime</strong></div>
            <div><span>05</span><strong>Complete</strong></div>
          </div>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__inner">
          <img class="closing__bird" src="/brand/fly-bird-filled.svg" alt="" aria-hidden="true" />
          <p class="eyebrow">FLY Unlimited</p>
          <h2 id="closing-title">There is a marketplace around you.</h2>
          <p>Open it.</p>

          <a
            class="button button--dark"
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root{
    --black:#090909;
    --ink:#111;
    --muted:#6e6e73;
    --line:rgba(17,17,17,.12);
    --paper:#f5f5f7;
    --purple:#b88cf1;
    --max:1240px;
    --pad:clamp(20px,4vw,64px);
  }

  *{box-sizing:border-box}

  html{
    margin:0;
    padding:0;
    scroll-behavior:smooth;
    background:#fff;
  }

  body{
    margin:0;
    padding:0;
    background:#fff;
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    overflow-x:hidden;
  }

  a{color:inherit}

  main{padding-top:0}

  .eyebrow{
    margin:0 0 16px;
    color:#86868b;
    font-size:10px;
    line-height:1;
    font-weight:800;
    letter-spacing:.18em;
    text-transform:uppercase;
  }

  .hero{
    padding:clamp(54px,6vw,90px) var(--pad) clamp(62px,7vw,102px);
    overflow:hidden;
    background:#fff;
  }

  .hero__inner{
    width:min(100%,var(--max));
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,.92fr) minmax(430px,.78fr);
    gap:clamp(64px,8vw,130px);
    align-items:center;
  }

  .hero h1{
    margin:0;
    max-width:10.2ch;
    font-size:clamp(62px,7vw,112px);
    line-height:.89;
    letter-spacing:-.064em;
    font-weight:760;
  }

  .hero h1 span{
    display:block;
  }

  .hero__primary{
    color:#0a0a0a;
  }

  .hero__secondary{
    margin-top:.03em;
    color:#9a9a9e;
  }

  .hero__lead{
    margin:28px 0 0;
    max-width:37rem;
    color:var(--muted);
    font-size:clamp(18px,1.55vw,23px);
    line-height:1.5;
    letter-spacing:-.018em;
  }

  .hero__actions{
    margin-top:32px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }

  .button{
    min-height:46px;
    padding:0 19px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:13px;
    font-weight:760;
  }

  .button--dark{
    background:#0a0a0a;
    color:#fff;
  }

  .button--light{
    border:1px solid rgba(10,10,10,.12);
    background:#fff;
    color:#111;
  }

  .askStage{
    position:relative;
    min-height:520px;
    display:grid;
    place-items:center;
  }

  .askStage::before{
    content:"";
    position:absolute;
    width:430px;
    height:430px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(184,140,241,.22),rgba(184,140,241,0) 68%);
    filter:blur(2px);
  }

  .askStage__card{
    position:relative;
    z-index:2;
    width:min(100%,390px);
    min-height:420px;
    padding:26px;
    border-radius:34px;
    background:#0a0a0a;
    color:#fff;
    box-shadow:0 34px 80px rgba(0,0,0,.22);
    transform:rotate(-2deg);
  }

  .askStage__top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    color:rgba(255,255,255,.48);
    font-size:10px;
    font-weight:800;
    letter-spacing:.16em;
  }

  .askStage__top span:last-child{
    width:32px;
    height:32px;
    border-radius:999px;
    display:grid;
    place-items:center;
    background:rgba(255,255,255,.09);
    color:#fff;
    font-size:19px;
    font-weight:400;
  }

  .askStage__prompt{
    margin:92px 0 0;
    color:rgba(255,255,255,.54);
    font-size:16px;
  }

  .askStage__field{
    margin-top:12px;
    display:flex;
    flex-direction:column;
    gap:2px;
    font-size:clamp(34px,4vw,50px);
    line-height:.98;
    letter-spacing:-.055em;
  }

  .askStage__field span{color:#fff}
  .askStage__field strong{color:#d8bcff;font-weight:680}

  .askStage__meta{
    position:absolute;
    left:26px;
    right:26px;
    bottom:28px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:8px;
  }

  .askStage__meta span{
    min-height:38px;
    border:1px solid rgba(255,255,255,.12);
    border-radius:999px;
