      /* ===== PHASE 2.0 — CAMPAIGN PHOTO SLOTS ===== */

      .campaign__photo,
      .closing__photo{
        object-position:var(--photo-position, center center);
      }

      .hero{--photo-position:58% center}
      .ask{--photo-position:54% center}
      .marketplace{--photo-position:55% center}
      .opportunity{--photo-position:57% center}
      .livetime{--photo-position:58% center}
      .payment{--photo-position:58% center}
      .closing{--photo-position:center center}

      @media(max-width:720px){
        .hero{--photo-position:62% center}
        .ask{--photo-position:58% center}
        .marketplace{--photo-position:58% center}
        .opportunity{--photo-position:60% center}
        .livetime{--photo-position:61% center}
        .payment{--photo-position:62% center}
        .closing{--photo-position:55% center}
      }



      /* ===== PHASE 2.1 — CLEAR HEADER + WARM BANNERS ===== */

      /* Float the existing FLY icon navigation directly over the hero. */
      .topbar{
        position:fixed;
        top:0;
        left:0;
        right:0;
        z-index:80;
        background:
          linear-gradient(
            180deg,
            rgba(5,5,5,.40) 0%,
            rgba(5,5,5,.16) 58%,
            rgba(5,5,5,0) 100%
          );
        border-bottom:0;
        box-shadow:none;
        backdrop-filter:none;
      }

      .topbarInner{
        background:transparent;
      }

      /* Existing logo + icon system stays; only presentation changes over photography. */
      .mascot{
        filter:brightness(0) invert(1);
      }

      .navBtn{
        color:#fff;
      }

      .navIcon{
        filter:brightness(0) invert(1);
      }

      .navBtn:hover{
        background:rgba(255,255,255,.12);
        color:#fff;
      }

      .navBtn.active{
        background:rgba(255,255,255,.18);
        color:#fff;
      }

      /* Give the floating controls just enough contrast without creating a bar. */
      .brand,
      .navBtn{
        text-shadow:0 1px 12px rgba(0,0,0,.22);
      }

      /* Header no longer consumes vertical space; hero starts at the very top. */
      .hero{
        margin-top:0;
      }

      @media(max-width:720px){
        .topbar{
          background:
            linear-gradient(
              180deg,
              rgba(5,5,5,.46) 0%,
              rgba(5,5,5,.18) 66%,
              rgba(5,5,5,0) 100%
            );
        }
      }



      /* ===== PHASE 2.2 — DARK GLASS HEADER ===== */

      /*
        Keep the existing FLY logo + icon menu, but anchor them inside
        one continuous translucent dark navigation surface.
      */
      .topbar{
        position:fixed;
        top:0;
        left:0;
        right:0;
        z-index:80;
        background:rgba(9,9,9,.54);
        border-bottom:1px solid rgba(255,255,255,.08);
        box-shadow:0 8px 28px rgba(0,0,0,.12);
        backdrop-filter:blur(18px) saturate(115%);
        -webkit-backdrop-filter:blur(18px) saturate(115%);
      }

      .topbarInner{
        background:transparent;
      }

      .mascot,
      .navIcon{
        filter:brightness(0) invert(1);
      }

      .navBtn{
        color:rgba(255,255,255,.92);
      }

      .navBtn:hover{
        background:rgba(255,255,255,.07);
        color:#fff;
      }

      .navBtn.active{
        background:rgba(255,255,255,.11);
        color:#fff;
      }

      .brand,
      .navBtn{
        text-shadow:none;
      }

      @media(max-width:720px){
        .topbar{
          background:rgba(9,9,9,.62);
          backdrop-filter:blur(16px) saturate(110%);
          -webkit-backdrop-filter:blur(16px) saturate(110%);
        }
      }


      /* ===== FOOTER ===== */
      .footer{
        padding:26px var(--pad) 38px;
        background:#0a0a0a;
        color:rgba(255,255,255,.48);
        font-size:12px;
      }

      .footerInner{
        width:min(100%,var(--max));
        margin:0 auto;
        display:flex;
        justify-content:space-between;
        gap:20px;
        flex-wrap:wrap;
      }

      .footerLinks{
        display:flex;
        gap:16px;
        flex-wrap:wrap;
      }

      @media(max-width:1000px){
        .campaign{
          min-height:720px;
        }

        .campaign__inner,
        .hero .campaign__inner{
          grid-template-columns:minmax(0,1fr) minmax(250px,.45fr);
          gap:28px;
        }

        .campaign__title{
          font-size:clamp(58px,9vw,104px);
        }

        .productStage{width:290px}
        .phone{width:260px;transform:translateY(60px)}

        .loopIntro{
          grid-template-columns:1fr;
          gap:18px;
        }

        .loopGrid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .loopItem:nth-child(2){border-right:0}
        .loopItem:nth-child(-n+2){border-bottom:1px solid var(--hair)}
      }

      @media(max-width:720px){
        :root{--pad:18px}

        .campaign{
          min-height:760px;
        }

        .campaign__photo{
          object-position:center;
        }

        .campaign::before,
        .hero::before,
        .ask::before,
        .marketplace::before{
          background:
            linear-gradient(180deg,rgba(6,6,6,.18) 0%,rgba(6,6,6,.26) 36%,rgba(6,6,6,.76) 78%,rgba(6,6,6,.86) 100%);
        }

        .campaign__inner,
        .hero .campaign__inner{
          min-height:760px;
          grid-template-columns:1fr;
          align-items:end;
          padding:56px 18px 0;
        }

        .campaign__copy{
          align-self:end;
          padding-bottom:36px;
        }

        .campaign__title{
          font-size:clamp(54px,16vw,82px);
          max-width:7.4ch;
        }

        .campaign__body{
          font-size:16px;
        }

        .productStage{
          width:100%;
          justify-self:center;
          justify-content:center;
          align-self:end;
          padding:0;
          height:315px;
        }

        .phone{
          width:245px;
          transform:translateY(34px);
        }

        .hero{
          min-height:760px;
        }

        .hero .campaign__inner{
          padding-bottom:48px;
        }

        .hero .productStage{display:none}

        .heroActions{
          width:100%;
        }

        .cta{
          flex:1 1 100%;
        }

        .loop{
          padding:72px 18px 82px;
        }

        .loopTitle{
          font-size:clamp(40px,13vw,62px);
        }

        .loopBody{font-size:16px}

        .loopGrid{
          grid-template-columns:1fr;
          border-bottom:0;
        }

        .loopItem{
          min-height:220px;
          border-right:0;
          border-bottom:1px solid var(--hair);
          padding:22px 0 24px;
        }

        .loopWord{
          font-size:clamp(48px,17vw,68px);
        }

        .footer{
          padding-left:18px;
          padding-right:18px;
        }
      }

      @media(prefers-reduced-motion:reduce){
        html{scroll-behavior:auto}
        *{transition:none!important}
      }
    </style>
  </head>

  <body>
    <header class="topbar">
      <div class="topbarInner">
        <a class="brand" href="/" aria-label="FLY Unlimited">
          <img class="mascot" src="/logo-alt.png" alt="FLY mascot" />
        </a>

        <nav class="nav" aria-label="Navigation">
          <a class="navBtn" href="/" aria-label="Home" title="Home">
            <img class="navIcon" src="/flyhome.svg" alt="" aria-hidden="true" />
          </a>

          <a class="navBtn active" href="/how-it-works/" aria-label="How it works" title="How it works">
            <img class="navIcon" src="/flyactive.svg" alt="" aria-hidden="true" />
          </a>

          <a class="navBtn" href="/info/" aria-label="Info" title="Info">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 10.6v6" />
              <path d="M12 7.4h.01" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- PHASE 2.2 — DARK GLASS HEADER -->
      <!-- PHASE 2.1 — CLEAR HEADER + WARM BANNERS -->
      <!-- PHASE 2.0 — CAMPAIGN PHOTO SLOTS -->
      <!-- PHASE 1.9C — COPY + SPACING LOCK FIX -->
      <!-- PHASE 1.8 — BANNER SYSTEM -->
      <!-- PHASE 1.7 — CAMPAIGN TIGHTEN -->
      <!-- PHASE 1.6 — FLOW POLISH
           Campaign rhythm: brand → marketplace → people → practical guide
           → LiveTime → payment → benefits → use cases → FAQ → close.
           No app screenshots or phone graphics are shown. -->
<!-- HERO -->
      <section class="campaign hero" aria-labelledby="hero-title">
        <img class="campaign__photo" src={heroPhoto} alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">How FLY works</p>

            <h1 class="display campaign__title" id="hero-title">
              A marketplace where the <span class="accent">center is you.</span>
            </h1>

            <p class="campaign__sub">Ask. Connect. Repeat.</p>

            <p class="campaign__body">
              FLY is a social marketplace built around what you need, what you can offer,
              and the people and opportunities around you.
            </p>

            <div class="heroActions">
              <a class="cta primary" href={appStoreUrl} target="_blank" rel="noopener noreferrer">
                Download FLY
              </a>
              <a class="cta secondary" href="#ask">
                See how it works
              </a>
            </div>
          </div>

          <div></div>
        </div>
      </section>

<!-- ASK -->
      <section class="campaign ask" id="ask" aria-labelledby="ask-title">
        <img class="campaign__photo" src={askPhoto} alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">Start with what you need</p>

            <h2 class="display campaign__title" id="ask-title">
              Need something? Ask.
            </h2>

            <p class="campaign__sub">
              People. Places. Things. Skills. Nearby.
            </p>
          </div>

          <div class="productStage" aria-label="FLY marketplace preview">
            <div class="phone">
              <div class="phone__top">
                <div class="phone__island"></div>
              </div>

              <div class="phone__bar">
                <div class="phone__brand">FLY</div>
                <div class="phone__icons" aria-hidden="true"><span></span><span></span></div>
              </div>

              <div class="phone__tabs">
                <div class="phone__tab active">All</div>
                <div class="phone__tab">Live</div>
                <div class="phone__tab">Action</div>
                <div class="phone__tab">Open</div>
                <div class="phone__tab">Active</div>
              </div>

              <div class="phone__grid">
                <div class="flyCard">
                  <div class="flyCard__media"></div>
                  <div class="flyCard__copy">
                    <div class="flyCard__title">Photoshoot</div>
                    <div class="flyCard__meta">$150 · Today</div>
                  </div>
                </div>

                <div class="flyCard">
                  <div class="flyCard__media"></div>
                  <div class="flyCard__copy">
                    <div class="flyCard__title">Event setup</div>
                    <div class="flyCard__meta">$300 · Tomorrow</div>
                  </div>
                </div>

                <div class="flyCard">
                  <div class="flyCard__media"></div>
                  <div class="flyCard__copy">
                    <div class="flyCard__title">Apartment stay</div>
                    <div class="flyCard__meta">$120 · Miami</div>
                  </div>
                </div>

                <div class="flyCard">
                  <div class="flyCard__media"></div>
                  <div class="flyCard__copy">
                    <div class="flyCard__title">Graphic design</div>
                    <div class="flyCard__meta">$80 · Open</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

<!-- MARKETPLACE -->
      <section class="campaign marketplace" aria-labelledby="marketplace-title">
        <img class="campaign__photo" src={marketplacePhoto} alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">Discover what is around you</p>

            <h2 class="display campaign__title" id="marketplace-title">
              There’s a marketplace around you.
            </h2>

            <p class="campaign__sub">Open it.</p>
          </div>

          <div class="productStage" aria-label="FLY nearby marketplace preview">
            <div class="phone mapPhone">
              <div class="phone__top">
                <div class="phone__island"></div>
              </div>

              <div class="phone__bar">
                <div class="phone__brand">FLY</div>
                <div class="phone__icons" aria-hidden="true"><span></span><span></span></div>
              </div>

              <div class="phone__tabs">
                <div class="phone__tab active">All</div>
                <div class="phone__tab">Live</div>
                <div class="phone__tab">Action</div>
                <div class="phone__tab">Open</div>
              </div>

              <div class="mapArea">
                <div class="mapRoad"></div>
                <div class="pin p1"></div>
                <div class="pin p2"></div>
                <div class="pin p3"></div>
                <div class="pin p4"></div>
                <div class="me"></div>
              </div>

              <div class="mapResult">
                <div class="mapResult__img"></div>
                <div>
                  <div class="mapResult__title">Nearby FLY</div>
                  <div class="mapResult__meta">Open · Around you</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

<!-- REAL PEOPLE / OPPORTUNITIES -->
      <section class="campaign opportunity" aria-labelledby="opportunity-title">
        <img class="campaign__photo" src="/campaign/real-people-opportunities.png" alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">People make the marketplace</p>

            <h2 class="display campaign__title" id="opportunity-title">
              Real people. Real opportunities. Around you.
            </h2>

            <p class="campaign__sub">
              Collaborate. Get hired. Grow.
            </p>
          </div>

          <div class="featurePanel" aria-label="FLY collaboration preview">
            <div class="featurePanel__head">
              <div>
                <div class="featurePanel__title">Event collaboration</div>
                <div class="featurePanel__meta">FLY messages</div>
              </div>
              <div class="featurePanel__meta">Live</div>
            </div>

            <div class="messageThread">
              <div class="messageRow">
                <div class="avatarDot"></div>
                <div class="bubble">
                  I got the approvals and the documents.
                </div>
              </div>

              <div class="messageRow me">
                <div class="bubble">
                  Great — I got the photos taken.
                  <div class="attachmentThumb"></div>
                </div>
              </div>

              <div class="messageRow">
                <div class="avatarDot"></div>
                <div class="bubble">
                  Perfect. Let’s move it forward.
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

<!-- PRACTICAL HOW-TO -->
      <section class="guide" aria-labelledby="guide-title">
        <div class="guide__inner">
          <div class="guide__intro">
            <div>
              <p class="guide__eyebrow">How a FLY moves</p>
              <h2 class="guide__title" id="guide-title">
                From an ask to a finished FLY.
              </h2>
            </div>

            <p class="guide__lead">
              The details can change from one FLY to another, but the basic path stays easy to understand.
            </p>
          </div>

          <div class="guide__steps">
            <article class="guideStep">
              <div class="guideStep__num">01</div>
              <h3 class="guideStep__title">Create the FLY.</h3>
              <p class="guideStep__text">
                Say what you need, choose the type of FLY, and add the timing, location,
                payment or context that helps someone understand the opportunity.
              </p>
            </article>

            <article class="guideStep">
              <div class="guideStep__num">02</div>
              <h3 class="guideStep__title">Make it clear.</h3>
              <p class="guideStep__text">
                Add the <strong>goals, materials and important information</strong> that define
                what needs to happen. Photos and attachments can add context when they are useful.
              </p>
            </article>

            <article class="guideStep">
              <div class="guideStep__num">03</div>
              <h3 class="guideStep__title">Connect.</h3>
              <p class="guideStep__text">
                People can discover the FLY and respond when it fits them. From there,
                both sides can communicate and decide whether the connection makes sense.
              </p>
            </article>

            <article class="guideStep">
              <div class="guideStep__num">04</div>
              <h3 class="guideStep__title">Confirm the plan.</h3>
              <p class="guideStep__text">
                Before the work starts, make sure the important details are understood:
                what is happening, when it is happening, where it is happening, and what “done” means.
              </p>
            </article>

            <article class="guideStep">
              <div class="guideStep__num">05</div>
              <h3 class="guideStep__title">Move into LiveTime.</h3>
              <p class="guideStep__text">
                LiveTime is where the FLY moves from agreement to execution. Keep the conversation,
                directions, progress and updates connected to the FLY while it is happening.
              </p>
            </article>

            <article class="guideStep">
              <div class="guideStep__num">06</div>
              <h3 class="guideStep__title">Complete the FLY.</h3>
              <p class="guideStep__text">
                Finish the goals, add the updates or proof that matter, and close out the FLY.
                If payment is part of it, the agreed structure stays tied to the work.
              </p>
            </article>
          </div>
        </div>
      </section>

<!-- LIVETIME -->
      <section class="campaign livetime" aria-labelledby="livetime-title">
        <img class="campaign__photo" src="/campaign/livetime-yes-to-done.png" alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">Once you connect</p>

            <h2 class="display campaign__title" id="livetime-title">
              From “yes” to done.
            </h2>

            <p class="campaign__sub">
              Coordinate it live with LiveTime.
            </p>
          </div>

          <div class="featurePanel" aria-label="LiveTime preview">
            <div class="featurePanel__head">
              <div>
                <div class="featurePanel__title">LiveTime</div>
                <div class="featurePanel__meta">Ready to start</div>
              </div>
              <div class="featurePanel__meta">Details</div>
            </div>

            <div class="liveSteps">
              <div class="liveStep done">
                <div class="liveStep__icon">✓</div>
                <div>
                  <div class="liveStep__label">Message</div>
                  <div class="liveStep__sub">Conversation stays with the FLY</div>
                </div>
              </div>

              <div class="liveStep done">
                <div class="liveStep__icon">✓</div>
                <div>
                  <div class="liveStep__label">Confirm details</div>
                  <div class="liveStep__sub">Everyone knows what is happening</div>
                </div>
              </div>

              <div class="liveStep active">
                <div class="liveStep__icon">3</div>
                <div>
                  <div class="liveStep__label">Go to LiveTime</div>
                  <div class="liveStep__sub">Move from agreement to action</div>
                </div>
              </div>

              <div class="liveStep">
                <div class="liveStep__icon">4</div>
                <div>
                  <div class="liveStep__label">Start session</div>
                  <div class="liveStep__sub">Track progress and completion</div>
                </div>
              </div>
            </div>

            <div class="liveButton">Start LiveTime</div>
          </div>
        </div>
      </section>

<!-- PAYMENTS -->
      <section class="campaign payment" aria-labelledby="payment-title">
        <img class="campaign__photo" src="/campaign/get-paid-your-way.png" alt="" aria-hidden="true" />

        <div class="campaign__inner">
          <div class="campaign__copy">
            <p class="campaign__kicker">Built around how the work happens</p>

            <h2 class="display campaign__title" id="payment-title">
              Get paid your way.
            </h2>

            <p class="campaign__sub">
              Hourly. Daily. Weekly. Or when it’s done.
            </p>
          </div>

          <div class="featurePanel" aria-label="FLY payment preview">
            <div class="featurePanel__head">
              <div>
                <div class="featurePanel__title">Payment & payout</div>
                <div class="featurePanel__meta">Choose the structure</div>
              </div>
              <div class="featurePanel__meta">FLY</div>
            </div>

            <div class="payBody">
              <div class="payTabs">
                <div class="payTab active">Hourly</div>
                <div class="payTab">Daily</div>
                <div class="payTab">Weekly</div>
                <div class="payTab">Total</div>
              </div>

              <div class="payAmount">
                $120<span class="payUnit">/ hour</span>
              </div>

              <div class="earlyPay">
                <div>
                  <div class="earlyPay__title">Early Pay</div>
                  <div class="earlyPay__sub">Available when eligible</div>
                </div>
                <div class="toggle" aria-hidden="true"></div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <!-- WHY FLY / REAL LIFE -->
      <section class="brandProof" aria-labelledby="brand-proof-title">
        <div class="brandProof__inner">
          <div class="brandProof__top">
            <div>
              <p class="brandProof__eyebrow">Why FLY</p>
              <h2 class="brandProof__title" id="brand-proof-title">Built for real life.</h2>
            </div>

            <p class="brandProof__intro">
              Ask for what you need. Offer what you have. Find people and opportunities
              around you. Then move it forward in one place.
            </p>
          </div>

          <div class="brandProof__grid">
            <article class="brandProof__item">
              <div class="brandProof__num">01</div>
              <div>
                <h3 class="brandProof__itemTitle">One place to ask.</h3>
                <p class="brandProof__text">
                  Start with a real need, service, project, place or opportunity.
                </p>
              </div>
            </article>

            <article class="brandProof__item">
              <div class="brandProof__num">02</div>
              <div>
                <h3 class="brandProof__itemTitle">Opportunity around you.</h3>
                <p class="brandProof__text">
                  Discover people, skills and FLYs you may not have known were there.
                </p>
              </div>
            </article>

            <article class="brandProof__item">
              <div class="brandProof__num">03</div>
              <div>
                <h3 class="brandProof__itemTitle">Less coordination chaos.</h3>
                <p class="brandProof__text">
                  Keep the ask, expectations, communication and progress connected.
                </p>
              </div>
            </article>

            <article class="brandProof__item">
              <div class="brandProof__num">04</div>
              <div>
                <h3 class="brandProof__itemTitle">Move it to done.</h3>
                <p class="brandProof__text">
                  FLY is designed to help an opportunity move forward, not sit as a listing.
                </p>
              </div>
            </article>
          </div>

          <div class="brandProof__examples" aria-label="Examples of what you can use FLY for">
            <span>Photography</span>
            <span>Event help</span>
            <span>Collaboration</span>
            <span>Services</span>
            <span>Places</span>
            <span>Projects</span>
          </div>
        </div>
      </section>


      <!-- FAQ -->
      <section class="faq" aria-labelledby="faq-title">
        <div class="faq__inner">
          <div class="faq__top">
            <p class="faq__eyebrow">Questions</p>
            <h2 class="faq__title" id="faq-title">
              The simple version.
            </h2>
          </div>

          <div class="faqList">
            <details class="faqItem">
              <summary>
                <span>Is FLY only for jobs?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                No. Work can be one use case, but FLY is broader than a job board.
                A FLY can be a need, service, collaboration, place, resource, project or opportunity.
              </p>
            </details>

            <details class="faqItem">
              <summary>
                <span>Can I both post FLYs and respond to them?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                Yes. The marketplace is built so the same person can ask for something one day
                and offer a skill, service or solution the next.
              </p>
            </details>

            <details class="faqItem">
              <summary>
                <span>What is LiveTime?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                LiveTime is the part of FLY that helps connected users coordinate the actual work.
                It keeps communication and progress tied to the FLY instead of scattering everything across separate threads.
              </p>
            </details>

            <details class="faqItem">
              <summary>
                <span>Does every FLY have to include payment?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                No. Some FLYs may involve payment and others may not. When payment is part of a FLY,
                the structure can be defined clearly so both sides understand the arrangement.
              </p>
            </details>

            <details class="faqItem">
              <summary>
                <span>Do I have to be nearby?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                Not every FLY has to be local, but nearby discovery is an important part of the marketplace.
                Some opportunities make sense around you; others can happen remotely.
              </p>
            </details>

            <details class="faqItem">
              <summary>
                <span>What makes FLY different from just messaging someone?</span>
                <span class="faqPlus" aria-hidden="true">+</span>
              </summary>
              <p class="faqAnswer">
                A message starts a conversation. A FLY gives that conversation structure:
                the ask, the details, the people involved, the coordination and the finish all stay connected.
              </p>
            </details>
          </div>
        </div>
      </section>

<!-- CLOSING -->
      <section class="closing" aria-label="Time to FLY">
        <img class="closing__photo" src="/campaign/time-to-fly.png" alt="" aria-hidden="true" />

        <div class="closing__content">
          <img class="closing__logo" src="/logo-alt.png" alt="FLY" />
          <p class="closing__tag">Time to FLY</p>
          <p class="closing__sub">Open the marketplace around you.</p>

          <a
            class="closing__cta"
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Download FLY
          </a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footerInner">
        <div>© 2026 {siteName}</div>
        <div class="footerLinks">
          <a href="/">Home</a>
          <a href="/info/">Info</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href={"mailto:" + contactEmail}>Contact</a>
        </div>
      </div>
