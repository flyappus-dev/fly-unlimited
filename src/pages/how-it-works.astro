    <script is:inline>
      (() => {
        const bar = document.querySelector(".topbar");
        if (!bar) return;

        let ticking = false;

        const syncNavState = () => {
          const trigger = Math.max(40, bar.offsetHeight - 8);
          bar.classList.toggle("is-scrolled", window.scrollY >= trigger);
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            syncNavState();
            ticking = false;
          });
        };

        syncNavState();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", syncNavState, { passive: true });
      })();
    </script>


    <!-- ===== APPLE STEP CAROUSEL V42 ===== -->
    <script is:inline>
      (() => {
        const setup = () => {
          const section = document.querySelector('.how.stepsCarouselV42');
          if (!section || section.dataset.carouselReady === 'true') return;

          const scroller = section.querySelector('.howInner');
          const cards = Array.from(scroller?.querySelectorAll('.howRow') || []);
          const dotsHost = section.querySelector('.stepsCarouselV42__dots');
          const prev = section.querySelector('.stepsCarouselV42__prev');
          const next = section.querySelector('.stepsCarouselV42__next');

          if (!scroller || cards.length < 2 || !dotsHost || !prev || !next) return;
          section.dataset.carouselReady = 'true';

          cards.forEach((card, index) => {
            card.setAttribute('role', 'group');
            card.setAttribute('aria-roledescription', 'slide');
            card.setAttribute('aria-label', `Step ${index + 1} of ${cards.length}`);
          });

          const dots = cards.map((card, index) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'stepsCarouselV42__dot';
            button.setAttribute('aria-label', `Go to step ${index + 1}`);
            button.addEventListener('click', () => goTo(index));
            dotsHost.appendChild(button);
            return button;
          });

          let active = 0;
          let frame = 0;

          const targetLeft = (card) => card.offsetLeft - ((scroller.clientWidth - card.clientWidth) / 2);

          const goTo = (index, behavior = 'smooth') => {
            const bounded = Math.max(0, Math.min(cards.length - 1, index));
            scroller.scrollTo({ left: targetLeft(cards[bounded]), behavior });
          };

          const setActive = (index) => {
            active = Math.max(0, Math.min(cards.length - 1, index));
            dots.forEach((dot, i) => {
              dot.classList.toggle('is-active', i === active);
              dot.setAttribute('aria-current', i === active ? 'step' : 'false');
            });
            prev.disabled = active === 0;
            next.disabled = active === cards.length - 1;
          };

          const updateFromScroll = () => {
            frame = 0;
            const center = scroller.scrollLeft + (scroller.clientWidth / 2);
            let nearest = 0;
            let distance = Infinity;

            cards.forEach((card, index) => {
              const cardCenter = card.offsetLeft + (card.clientWidth / 2);
              const delta = Math.abs(cardCenter - center);
              if (delta < distance) {
                distance = delta;
                nearest = index;
              }
            });

            setActive(nearest);
          };

          scroller.addEventListener('scroll', () => {
            if (frame) cancelAnimationFrame(frame);
            frame = requestAnimationFrame(updateFromScroll);
          }, { passive: true });

          prev.addEventListener('click', () => goTo(active - 1));
          next.addEventListener('click', () => goTo(active + 1));

          section.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault();
              goTo(active - 1);
            } else if (event.key === 'ArrowRight') {
              event.preventDefault();
              goTo(active + 1);
            }
          });

          let resizeFrame = 0;
          window.addEventListener('resize', () => {
            if (resizeFrame) cancelAnimationFrame(resizeFrame);
            resizeFrame = requestAnimationFrame(() => goTo(active, 'auto'));
          }, { passive: true });

          setActive(0);
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setup, { once: true });
        } else {
          setup();
        }
      })();
    </script>
    <!-- ===== END APPLE STEP CAROUSEL V42 ===== -->

