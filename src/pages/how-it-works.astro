---
const siteName = "FLY Unlimited";
const contactEmail = "hello@fly-unlimited.com";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>How FLY Works • {siteName}</title>
    <meta
      name="description"
      content="See how FLY moves from a real-world ask to connection, coordination, completion, and payment."
    />

    <style>
      :root{
        --white:#fff;
        --black:#090909;
        --text:#111;
        --muted:#6e6e73;
        --hair:#d9d9dd;
        --panel:#f5f5f7;
        --yellow:#f2d35c;
        --max:1180px;
        --pad:clamp(20px,4vw,48px);
        --ease:cubic-bezier(.2,.8,.2,1);
      }

      *{box-sizing:border-box}

      html{
        scroll-behavior:smooth;
        background:#fff;
      }

      html,body{
        margin:0;
        padding:0;
        background:#fff;
        color:var(--text);
      }

      body{
        font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
        -webkit-font-smoothing:antialiased;
        text-rendering:optimizeLegibility;
        overflow-x:hidden;
      }

      a{color:inherit;text-decoration:none}

      a:focus-visible{
        outline:2px solid currentColor;
        outline-offset:4px;
      }

      .topbar{
        position:fixed;
        top:0;
        left:0;
        right:0;
        z-index:100;
        background:rgba(9,9,9,.54);
        border-bottom:1px solid rgba(255,255,255,.08);
        box-shadow:0 8px 28px rgba(0,0,0,.10);
        backdrop-filter:blur(18px) saturate(115%);
        -webkit-backdrop-filter:blur(18px) saturate(115%);
      }

      .topbarInner{
        max-width:1120px;
        margin:0 auto;
        padding:10px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
      }

      .brand{
        min-height:44px;
        display:flex;
        align-items:center;
      }

      .mascot{
        width:26px;
        height:26px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .nav{
        display:flex;
        align-items:center;
        gap:10px;
      }

      .navBtn{
        width:42px;
        height:42px;
        display:grid;
        place-items:center;
        border-radius:999px;
        color:rgba(255,255,255,.92);
        transition:background .18s var(--ease),color .18s var(--ease);
      }

      .navBtn:hover{
        background:rgba(255,255,255,.07);
        color:#fff;
      }

      .navBtn.active{
        background:rgba(255,255,255,.11);
        color:#fff;
      }

      .navIcon{
        width:18px;
        height:18px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .navBtn svg{
        width:18px;
        height:18px;
        stroke:currentColor;
        stroke-width:2.2;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      .hero{
        position:relative;
        min-height:620px;
        overflow:hidden;
        isolation:isolate;
        background:#6c655f;
      }

      .heroPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        z-index:-3;
        filter:saturate(.76) contrast(.98) brightness(.88);
      }

      .hero::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-2;
        background:
          linear-gradient(90deg,rgba(0,0,0,.67) 0%,rgba(0,0,0,.50) 35%,rgba(0,0,0,.18) 62%,rgba(0,0,0,.03) 100%),
          linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.14));
      }

      .heroInner{
        width:min(100%,var(--max));
        min-height:620px;
        margin:0 auto;
        padding:128px var(--pad) 64px;
        display:flex;
        align-items:flex-end;
      }

      .heroCopy{
        width:min(100%,620px);
      }

      .heroEyebrow{
        margin:0 0 14px;
        color:rgba(255,255,255,.70);
        font-size:12px;
        font-weight:700;
        letter-spacing:.12em;
        text-transform:uppercase;
      }

      .heroTitle{
        margin:0;
        color:#fff;
        font-size:clamp(64px,7vw,108px);
        line-height:.88;
        letter-spacing:-.055em;
        font-weight:700;
      }

      .heroLead{
        margin:20px 0 0;
        color:#fff;
        font-size:clamp(25px,2.2vw,34px);
        line-height:1.08;
        letter-spacing:-.035em;
        font-weight:500;
      }

      .heroSub{
        margin:10px 0 0;
        color:rgba(255,255,255,.76);
        font-size:17px;
        line-height:1.5;
      }

      .heroCta{
        margin-top:24px;
        min-height:44px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        border-radius:999px;
        background:#fff;
        color:#111;
        font-size:14px;
        font-weight:600;
      }

      .stepNav{
        background:#fff;
        border-bottom:1px solid var(--hair);
      }

      .stepNavInner{
        width:min(100%,var(--max));
        margin:0 auto;
        padding:0 var(--pad);
        display:grid;
        grid-template-columns:repeat(5,minmax(0,1fr));
      }

      .stepNavItem{
        min-height:74px;
        display:flex;
        flex-direction:column;
        align-items:center;
        justify-content:center;
        text-align:center;
        position:relative;
      }

      .stepNavItem:not(:last-child)::after{
        content:"";
        position:absolute;
        right:0;
        top:22px;
        bottom:22px;
        width:1px;
        background:var(--hair);
      }

      .stepNavNum{
        color:#8a8a8e;
        font-size:12px;
        line-height:1;
      }

      .stepNavLabel{
        margin-top:5px;
        font-size:14px;
        font-weight:600;
      }

      .how{background:#fff}

      .howInner{
        width:min(100%,var(--max));
        margin:0 auto;
        padding:18px var(--pad) 22px;
      }

      .howRow{
        display:grid;
        grid-template-columns:minmax(260px,.42fr) minmax(0,.58fr);
        gap:clamp(36px,6vw,88px);
        align-items:center;
        padding:38px 0;
        border-bottom:1px solid var(--hair);
      }

      .howRow:last-child{border-bottom:0}

      .howNum{
        margin:0 0 8px;
        color:#8a8a8e;
        font-size:13px;
        line-height:1;
      }

      .howTitle{
        margin:0;
        font-size:clamp(28px,2.7vw,42px);
        line-height:1.03;
        letter-spacing:-.04em;
        font-weight:650;
      }

      .howText{
        margin:9px 0 0;
        max-width:33rem;
        color:var(--muted);
        font-size:17px;
        line-height:1.5;
      }

      .productCard{
        min-height:210px;
        border-radius:18px;
        background:var(--panel);
        display:flex;
        align-items:center;
        justify-content:center;
        text-align:center;
        padding:30px;
      }

      .productCardContent{
        display:grid;
        justify-items:center;
        gap:10px;
      }

      .productIcon{
        width:44px;
        height:44px;
        stroke:#111;
        stroke-width:1.8;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      .productLabel{
        color:#3a3a3c;
        font-size:16px;
        font-weight:500;
      }

      .live{
        position:relative;
        min-height:310px;
        overflow:hidden;
        isolation:isolate;
        background:#4f4a46;
      }

      .livePhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        z-index:-2;
        filter:saturate(.75) contrast(.98) brightness(.83);
      }

      .live::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-1;
        background:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.38) 48%,rgba(0,0,0,.05) 78%);
      }

      .liveInner{
        width:min(100%,var(--max));
        min-height:310px;
        margin:0 auto;
        padding:44px var(--pad);
        display:flex;
        align-items:flex-end;
      }

      .liveCopy{max-width:560px}

      .liveEyebrow{
        margin:0 0 10px;
        color:rgba(255,255,255,.68);
        font-size:11px;
        font-weight:700;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .liveTitle{
        margin:0;
        color:#fff;
        font-size:clamp(42px,4.5vw,68px);
        line-height:.94;
        letter-spacing:-.045em;
        font-weight:650;
      }

      .liveText{
        margin:12px 0 0;
        color:rgba(255,255,255,.78);
        font-size:17px;
        line-height:1.5;
      }

      .why{
        background:#fff;
        padding:64px var(--pad) 72px;
      }

      .whyInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .whyTitle{
        margin:0;
        font-size:clamp(46px,5vw,72px);
        line-height:.95;
        letter-spacing:-.05em;
        font-weight:650;
      }

      .whyGrid{
        margin-top:34px;
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:50px;
      }

      .whyCol + .whyCol{
        border-left:1px solid var(--hair);
        padding-left:50px;
      }

      .whyKicker{
        margin:0 0 22px;
        font-size:11px;
        font-weight:700;
        letter-spacing:.18em;
        text-transform:uppercase;
      }

      .benefit{
        display:grid;
        grid-template-columns:46px 1fr;
        gap:16px;
        align-items:start;
      }

      .benefit + .benefit{margin-top:22px}

      .benefitIcon{
        width:46px;
        height:46px;
        border-radius:999px;
        background:#f2f2f2;
        display:grid;
        place-items:center;
      }

      .benefitIcon svg{
        width:23px;
        height:23px;
        stroke:#111;
        stroke-width:1.9;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      .benefitTitle{
        margin:2px 0 0;
        font-size:16px;
        font-weight:650;
      }

      .benefitText{
        margin:4px 0 0;
        color:var(--muted);
        font-size:14px;
        line-height:1.45;
      }

      .final{
        background:#fff;
        padding:0 var(--pad) 28px;
      }

      .finalInner{
        width:min(100%,var(--max));
        min-height:260px;
        margin:0 auto;
        position:relative;
        overflow:hidden;
        border-radius:18px;
        isolation:isolate;
        background:#655d55;
      }

      .finalPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        z-index:-2;
        filter:saturate(.74) contrast(.97) brightness(.86);
      }

      .finalInner::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-1;
        background:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.34) 53%,rgba(0,0,0,.02) 82%);
      }

      .finalCopy{
        min-height:260px;
        padding:42px 48px;
        display:flex;
        flex-direction:column;
        justify-content:center;
        max-width:620px;
      }

      .finalKicker{
        margin:0 0 8px;
        color:rgba(255,255,255,.66);
        font-size:11px;
        font-weight:700;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .finalTitle{
        margin:0;
        color:#fff;
        font-size:clamp(48px,5vw,72px);
        line-height:.95;
        letter-spacing:-.05em;
        font-weight:650;
      }

      .finalText{
        margin:10px 0 0;
        color:rgba(255,255,255,.78);
        font-size:16px;
        line-height:1.45;
      }

      .finalActions{
        margin-top:20px;
        display:flex;
        gap:10px;
        flex-wrap:wrap;
      }

      .finalBtn{
        min-height:42px;
        padding:0 17px;
        border-radius:999px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font-size:13px;
        font-weight:600;
        border:1px solid rgba(255,255,255,.46);
        color:#fff;
      }

      .finalBtn.primary{
        background:#fff;
        color:#111;
        border-color:#fff;
      }

      .footer{
        padding:24px var(--pad) 38px;
        background:#fff;
        color:#86868b;
        font-size:12px;
      }

      .footerInner{
        width:min(100%,var(--max));
        margin:0 auto;
        border-top:1px solid var(--hair);
        padding-top:22px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:18px;
        flex-wrap:wrap;
      }

      .footerLinks{
        display:flex;
        gap:16px;
        flex-wrap:wrap;
      }

      @media(max-width:900px){
        .howRow{
          grid-template-columns:minmax(220px,.42fr) minmax(0,.58fr);
          gap:32px;
        }

        .whyGrid{gap:32px}

        .whyCol + .whyCol{padding-left:32px}
      }

      @media(max-width:720px){
        :root{--pad:18px}

        .topbar{
          background:rgba(9,9,9,.62);
          backdrop-filter:blur(16px) saturate(110%);
          -webkit-backdrop-filter:blur(16px) saturate(110%);
        }

        .hero,
        .heroInner{
          min-height:700px;
        }

        .heroPhoto{object-position:62% center}

        .hero::before{
          background:
            linear-gradient(180deg,rgba(0,0,0,.12) 0%,rgba(0,0,0,.20) 37%,rgba(0,0,0,.70) 79%,rgba(0,0,0,.82) 100%);
        }

        .heroInner{
          padding:118px 18px 48px;
          align-items:flex-end;
        }

        .heroTitle{font-size:clamp(58px,17vw,76px)}
        .heroLead{font-size:26px}
        .heroSub{font-size:16px}
        .heroCta{width:100%}

        .stepNavInner{
          padding:0;
          grid-template-columns:repeat(5,128px);
          overflow-x:auto;
          -webkit-overflow-scrolling:touch;
          scrollbar-width:none;
        }

        .stepNavInner::-webkit-scrollbar{display:none}

        .stepNavItem{min-height:68px}

        .howInner{padding:0 18px}

        .howRow{
          grid-template-columns:1fr;
          gap:22px;
          padding:40px 0;
        }

        .howTitle{font-size:34px}
        .howText{font-size:16px}

        .productCard{
          min-height:190px;
          border-radius:16px;
        }

        .live{min-height:430px}

        .livePhoto{object-position:60% center}

        .live::before{
          background:linear-gradient(180deg,rgba(0,0,0,.10),rgba(0,0,0,.72) 78%,rgba(0,0,0,.82));
        }

        .liveInner{
          min-height:430px;
          padding:42px 18px;
        }

        .liveTitle{font-size:50px}

        .why{padding:58px 18px 64px}
        .whyTitle{font-size:48px}

        .whyGrid{
          grid-template-columns:1fr;
          gap:38px;
        }

        .whyCol + .whyCol{
          border-left:0;
          border-top:1px solid var(--hair);
          padding-left:0;
          padding-top:34px;
        }

        .final{padding:0 18px 22px}

        .finalInner{min-height:430px}
        .finalPhoto{object-position:62% center}

        .finalInner::before{
          background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.72) 75%,rgba(0,0,0,.82));
        }

        .finalCopy{
          min-height:430px;
          padding:36px 24px;
          justify-content:flex-end;
        }

        .finalTitle{font-size:54px}

        .finalBtn{flex:1 1 100%}
      }

      @media(max-width:390px){
        .heroTitle{font-size:54px}
        .heroLead{font-size:23px}
        .howTitle{font-size:31px}
        .whyTitle{font-size:44px}
        .finalTitle{font-size:48px}
      }

      @media(prefers-reduced-motion:reduce){
        html{scroll-behavior:auto}
        *{transition:none!important}
      }


      /* ===== PHASE 7 — RESPONSIVE / NAV FOUNDATION ===== */
      :root{ --fly-nav-h:64px; }

      body{
        padding-top:var(--fly-nav-h) !important;
      }

      .topbar{
        min-height:var(--fly-nav-h);
      }

      @media(max-width:900px){
        .hero,
        .live{
          min-height:0 !important;
          height:auto !important;
          display:flex !important;
          flex-direction:column !important;
          background:#111 !important;
        }

        .heroPhoto,
        .livePhoto{
          position:relative !important;
          inset:auto !important;
          order:0 !important;
          width:100% !important;
          height:auto !important;
          object-fit:contain !important;
          object-position:center !important;
          display:block !important;
          filter:none !important;
          background:#111 !important;
        }

        .hero::before,
        .live::before{
          display:none !important;
        }

        .heroInner,
        .liveInner{
          order:1 !important;
          min-height:0 !important;
          height:auto !important;
          display:block !important;
          padding:34px 22px 40px !important;
          background:#111 !important;
        }

        .heroCopy,
        .liveCopy{
          width:100% !important;
          max-width:680px !important;
        }

        .heroTitle,
        .heroLead,
        .heroSub,
        .liveTitle,
        .liveText,
        .heroEyebrow,
        .liveEyebrow{
          color:#fff !important;
        }

        .heroSub,
        .heroEyebrow,
        .liveText,
        .liveEyebrow{
          color:rgba(255,255,255,.72) !important;
        }

        .finalInner{
          display:flex !important;
          flex-direction:column !important;
          min-height:0 !important;
          background:#111 !important;
        }

        .finalPhoto{
          position:relative !important;
          inset:auto !important;
          width:100% !important;
          height:auto !important;
          object-fit:contain !important;
          object-position:center !important;
          filter:none !important;
          order:0 !important;
        }

        .finalInner::before{
          display:none !important;
        }

        .finalCopy{
          order:1 !important;
          min-height:0 !important;
          max-width:none !important;
          padding:30px 28px 34px !important;
          background:#111 !important;
        }
      }

      @media(max-width:720px){
        .stepNavInner{
          scroll-snap-type:x mandatory;
        }

        .stepNavItem{
          scroll-snap-align:start;
        }

        .howRow{
          padding:34px 0 !important;
        }

        .productCard{
          min-height:170px !important;
        }
      }

      @media(max-width:560px){
        .heroInner,
        .liveInner{
          padding:28px 18px 34px !important;
        }

        .heroTitle{
          font-size:clamp(48px,14vw,64px) !important;
          line-height:.94 !important;
        }

        .heroLead{
          font-size:23px !important;
        }

        .heroCta{
          width:100% !important;
        }

        .howTitle{
          font-size:31px !important;
        }

        .why{
          padding-left:18px !important;
          padding-right:18px !important;
        }

        .whyTitle{
          font-size:44px !important;
        }

        .final{
          padding-left:18px !important;
          padding-right:18px !important;
        }

        .finalCopy{
          padding:26px 22px 30px !important;
        }

        .finalTitle{
          font-size:46px !important;
        }
      }



      /* ===== PHASE 8 — WAYS TO FLY ===== */
      .ways{
        padding:72px var(--pad) 82px;
        background:#fff;
      }

      .waysInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .waysEyebrow{
        margin:0 0 12px;
        color:#86868b;
        font-size:11px;
        font-weight:700;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .waysTitle{
        margin:0;
        max-width:10ch;
        font-size:clamp(46px,5vw,72px);
        line-height:.95;
        letter-spacing:-.05em;
        font-weight:650;
      }

      .waysLead{
        margin:16px 0 0;
        max-width:46rem;
        color:var(--muted);
        font-size:18px;
        line-height:1.55;
      }

      .waysGrid{
        margin-top:36px;
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .wayCard{
        min-height:210px;
        padding:24px 22px 26px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
      }

      .wayCard:last-child{border-right:0}

      .wayIndex{
        color:#86868b;
        font-size:12px;
      }

      .wayCard h3{
        margin:auto 0 0;
        font-size:25px;
        line-height:1;
        letter-spacing:-.04em;
        font-weight:650;
      }

      .wayCard p{
        margin:10px 0 0;
        color:var(--muted);
        font-size:14px;
        line-height:1.48;
      }

      @media(max-width:900px){
        .waysGrid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .wayCard:nth-child(2){border-right:0}

        .wayCard:nth-child(-n+2){
          border-bottom:1px solid var(--hair);
        }
      }

      @media(max-width:560px){
        .ways{
          padding:58px 18px 64px;
        }

        .waysTitle{font-size:44px}
        .waysLead{font-size:16px}

        .waysGrid{
          grid-template-columns:1fr;
          margin-top:30px;
        }

        .wayCard{
          min-height:auto;
          padding:22px 0;
          border-right:0;
          border-bottom:1px solid var(--hair);
        }

        .wayCard:last-child{border-bottom:0}

        .wayCard h3{
          margin:26px 0 0;
        }
      }



      /* ===== PHASE 9 — PROFESSIONAL COMPANY POLISH ===== */
      :root{
        --fly-nav-h:64px;
        --fly-safe-top:env(safe-area-inset-top, 0px);
        --fly-safe-bottom:env(safe-area-inset-bottom, 0px);
      }

      html{
        scroll-padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top) + 14px);
      }

      body{
        padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top)) !important;
      }

      .topbar{
        min-height:calc(var(--fly-nav-h) + var(--fly-safe-top));
        padding-top:var(--fly-safe-top);
      }

      [id]{
        scroll-margin-top:calc(var(--fly-nav-h) + var(--fly-safe-top) + 18px);
      }

      button,
      a{
        -webkit-tap-highlight-color:transparent;
      }

      .navBtn{
        min-width:42px;
        min-height:42px;
      }

      /* Keep the site sharp and restrained on large screens. */
      main p{
        text-wrap:pretty;
      }

      h1,h2,h3{
        text-wrap:balance;
      }

      .heroActions a,
      .heroBtn,
      .heroCta,
      .cta,
      .finalBtn,
      .closingBtn,
      .askBannerLink{
        min-height:44px;
        transition:
          transform .18s var(--ease, cubic-bezier(.2,.8,.2,1)),
          opacity .18s ease,
          background .18s ease,
          border-color .18s ease;
      }

      @media(hover:hover){
        .heroActions a:hover,
        .heroBtn:hover,
        .heroCta:hover,
        .cta:hover,
        .finalBtn:hover,
        .closingBtn:hover,
        .askBannerLink:hover{
          transform:translateY(-1px);
        }
      }

      /* Better tablet rhythm — do not let desktop compositions feel cramped. */
      @media(min-width:721px) and (max-width:1100px){
        :root{
          --pad:clamp(28px,4vw,44px);
        }

        .topbarInner{
          padding-left:24px;
          padding-right:24px;
        }
      }

      /* iPhone / app-webview finishing pass. */
      @media(max-width:720px){
        body{
          padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top)) !important;
        }

        .topbarInner{
          min-height:var(--fly-nav-h);
          padding-left:18px;
          padding-right:18px;
        }

        .nav{
          gap:6px;
        }

        .navBtn{
          width:40px;
          height:40px;
        }

        .footer{
          padding-bottom:calc(34px + var(--fly-safe-bottom)) !important;
        }

        .footerInner{
          align-items:flex-start !important;
        }

        .footerLinks{
          row-gap:10px !important;
        }
      }

      @media(max-width:390px){
        .topbarInner{
          padding-left:14px;
          padding-right:14px;
        }
      }

      @media(prefers-reduced-motion:reduce){
        *{
          scroll-behavior:auto !important;
          animation:none !important;
          transition:none !important;
        }
      }


      /* ===== PHASE 9 — HOW IT WORKS FINISHING ===== */
      .stepNav{
        position:relative;
        z-index:2;
      }

      .stepNavItem{
        transition:background .16s ease;
      }

      @media(hover:hover){
        .stepNavItem:hover{
          background:#f7f7f8;
        }
      }

      .productCard{
        border:1px solid rgba(0,0,0,.035);
        box-shadow:inset 0 1px 0 rgba(255,255,255,.8);
      }

      .waysGrid,
      .whyGrid{
        max-width:100%;
      }

      .wayCard h3,
      .benefitTitle{
        letter-spacing:-.02em;
      }

      @media(max-width:720px){
        .stepNav{
          position:sticky;
          top:calc(var(--fly-nav-h) + var(--fly-safe-top));
          z-index:60;
          box-shadow:0 1px 0 rgba(0,0,0,.08);
        }

        .stepNavInner{
          background:rgba(255,255,255,.94);
          backdrop-filter:blur(14px) saturate(120%);
          -webkit-backdrop-filter:blur(14px) saturate(120%);
        }

        .stepNavItem{
          min-height:62px !important;
        }

        .stepNavNum{
          font-size:11px;
        }

        .stepNavLabel{
          font-size:13px;
        }
      }

</style>
  </head>

  <body>
    <header class="topbar">
      <div class="topbarInner">
        <a class="brand" href="/" aria-label="FLY Unlimited">
          <img class="mascot" src="/logo-alt.png" alt="FLY mascot" />
        </a>

        <nav class="nav" aria-label="Navigation">
          <a class="navBtn" href="/" aria-label="Home" title="Home">
            <img class="navIcon" src="/flyhome.svg" alt="" aria-hidden="true" />
          </a>

          <a class="navBtn active" href="/how-it-works/" aria-label="How it works" title="How it works">
            <img class="navIcon" src="/flyactive.svg" alt="" aria-hidden="true" />
          </a>

          <a class="navBtn" href="/info/" aria-label="Info" title="Info">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 10.6v6"></path>
              <path d="M12 7.4h.01"></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- FLY HOW IT WORKS — APPLE-LIKE V1 -->
      <section class="hero" aria-labelledby="how-title">
        <img class="heroPhoto" src="/campaign/hero-center-you.png" alt="" aria-hidden="true" />

        <div class="heroInner">
          <div class="heroCopy">
            <p class="heroEyebrow">How FLY works</p>
            <h1 class="heroTitle" id="how-title">How FLY<br />Works</h1>
            <p class="heroLead">One network. Built around you.</p>
            <p class="heroSub">Create. Discover. Connect. LiveTime. Complete.</p>
            <a class="heroCta" href="#create">See how it works <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="stepNav" aria-label="FLY flow">
        <div class="stepNavInner">
          <a class="stepNavItem" href="#create"><span class="stepNavNum">01</span><span class="stepNavLabel">Create</span></a>
          <a class="stepNavItem" href="#discover"><span class="stepNavNum">02</span><span class="stepNavLabel">Discover</span></a>
          <a class="stepNavItem" href="#connect"><span class="stepNavNum">03</span><span class="stepNavLabel">Connect</span></a>
          <a class="stepNavItem" href="#livetime"><span class="stepNavNum">04</span><span class="stepNavLabel">LiveTime</span></a>
          <a class="stepNavItem" href="#complete"><span class="stepNavNum">05</span><span class="stepNavLabel">Complete</span></a>
        </div>
      </section>

      <section class="how">
        <div class="howInner">
          <article class="howRow" id="create">
            <div>
              <p class="howNum">01</p>
              <h2 class="howTitle">Create the FLY</h2>
              <p class="howText">Post what you need, what you offer, or what you want to make happen — from a service or collab to a stay or rental.</p>
            </div>
            <div class="productCard" aria-label="Reserved Create FLY visual">
              <div class="productCardContent">
                <svg class="productIcon" viewBox="0 0 48 48" aria-hidden="true">
                  <rect x="12" y="8" width="24" height="32" rx="4"></rect>
                  <path d="M18 17h12M18 23h8"></path>
                  <circle cx="34" cy="34" r="7"></circle>
                  <path d="M34 30v8M30 34h8"></path>
                </svg>
                <span class="productLabel">Create</span>
              </div>
            </div>
          </article>

          <article class="howRow" id="discover">
            <div>
              <p class="howNum">02</p>
              <h2 class="howTitle">Discover your network</h2>
              <p class="howText">Explore people, services, stays, rentals, collabs and opportunities around you.</p>
            </div>
            <div class="productCard" aria-label="Reserved discovery visual">
              <div class="productCardContent">
                <svg class="productIcon" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M24 42s12-11.2 12-22A12 12 0 0 0 12 20c0 10.8 12 22 12 22Z"></path>
                  <circle cx="24" cy="20" r="4"></circle>
                </svg>
                <span class="productLabel">Discover</span>
              </div>
            </div>
          </article>

          <article class="howRow" id="connect">
            <div>
              <p class="howNum">03</p>
              <h2 class="howTitle">Connect and confirm</h2>
              <p class="howText">Message, apply, book, hire or collaborate — then confirm the plan together.</p>
            </div>
            <div class="productCard" aria-label="Reserved connection visual">
              <div class="productCardContent">
                <svg class="productIcon" viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M10 11h28a4 4 0 0 1 4 4v17a4 4 0 0 1-4 4H22l-9 7v-7h-3a4 4 0 0 1-4-4V15a4 4 0 0 1 4-4Z"></path>
                </svg>
                <span class="productLabel">Connect</span>
              </div>
            </div>
          </article>

          <article class="howRow" id="livetime">
            <div>
              <p class="howNum">04</p>
              <h2 class="howTitle">Move into LiveTime</h2>
              <p class="howText">When it’s time to move, LiveTime keeps the plan, communication, progress and updates connected while it’s happening.</p>
            </div>
            <div class="productCard" aria-label="Reserved LiveTime visual">
              <div class="productCardContent">
                <svg class="productIcon" viewBox="0 0 48 48" aria-hidden="true">
                  <circle cx="24" cy="14" r="6"></circle>
                  <circle cx="11" cy="20" r="4"></circle>
                  <circle cx="37" cy="20" r="4"></circle>
                  <path d="M13 39c0-7 4-12 11-12s11 5 11 12"></path>
                  <path d="M3 39c0-5 3-9 8-9M45 39c0-5-3-9-8-9"></path>
                </svg>
                <span class="productLabel">LiveTime</span>
              </div>
            </div>
          </article>

          <article class="howRow" id="complete">
            <div>
              <p class="howNum">05</p>
              <h2 class="howTitle">Complete the FLY</h2>
              <p class="howText">Finish the FLY, mark it complete, and handle payment when payment is part of the experience.</p>
            </div>
            <div class="productCard" aria-label="Reserved completion and payment visual">
              <div class="productCardContent">
                <svg class="productIcon" viewBox="0 0 48 48" aria-hidden="true">
                  <rect x="7" y="12" width="34" height="24" rx="4"></rect>
                  <path d="M7 20h34M13 30h10"></path>
                </svg>
                <span class="productLabel">Complete</span>
              </div>
            </div>
          </article>
        </div>
      </section>


      <!-- FLY PHASE 8 — WAYS TO FLY -->
      <section class="ways" aria-labelledby="ways-title">
        <div class="waysInner">
          <p class="waysEyebrow">One network. Different ways to use it.</p>
          <h2 class="waysTitle" id="ways-title">One network. Many ways to FLY.</h2>
          <p class="waysLead">
            Services, stays, rentals and collabs live in the same marketplace — centered around you.
          </p>

          <div class="waysGrid">
            <article class="wayCard">
              <span class="wayIndex">01</span>
              <h3>Services</h3>
              <p>Find help, offer a skill, or hire someone for what you need.</p>
            </article>

            <article class="wayCard">
              <span class="wayIndex">02</span>
              <h3>Collabs</h3>
              <p>Build, create, coordinate, and move ideas forward with other people.</p>
            </article>

            <article class="wayCard">
              <span class="wayIndex">03</span>
              <h3>Stays</h3>
              <p>Discover places to stay through the same network you already use.</p>
            </article>

            <article class="wayCard">
              <span class="wayIndex">04</span>
              <h3>Rentals</h3>
              <p>Access things you need without turning to a completely different marketplace.</p>
            </article>
          </div>
        </div>
      </section>

<section class="live" aria-labelledby="live-title">
        <img class="livePhoto" src="/campaign/livetime-yes-to-done.png" alt="" aria-hidden="true" />
        <div class="liveInner">
          <div class="liveCopy">
            <p class="liveEyebrow">LiveTime</p>
            <h2 class="liveTitle" id="live-title">Keeps the FLY moving.</h2>
            <p class="liveText">LiveTime keeps the plan, communication and progress connected while the FLY is happening.</p>
          </div>
        </div>
      </section>

      <section class="why" aria-labelledby="why-title">
        <div class="whyInner">
          <h2 class="whyTitle" id="why-title">Built for real life.</h2>
          <div class="whyGrid">
            <div class="whyCol">
              <p class="whyKicker">For people</p>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-7 11h6l-1 9 7-12h-6z"></path></svg>
                </div>
                <div>
                  <p class="benefitTitle">Simple</p>
                  <p class="benefitText">Start with a real need, offer, or idea.</p>
                </div>
              </div>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21s7-6.6 7-13a7 7 0 1 0-14 0c0 6.4 7 13 7 13Z"></path>
                    <circle cx="12" cy="8" r="2"></circle>
                  </svg>
                </div>
                <div>
                  <p class="benefitTitle">Nearby</p>
                  <p class="benefitText">Discover people and opportunities around you.</p>
                </div>
              </div>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg>
                </div>
                <div>
                  <p class="benefitTitle">Actionable</p>
                  <p class="benefitText">Move from interest to action.</p>
                </div>
              </div>
            </div>

            <div class="whyCol">
              <p class="whyKicker">For businesses</p>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="3"></circle>
                    <circle cx="5" cy="10" r="2"></circle>
                    <circle cx="19" cy="10" r="2"></circle>
                    <path d="M7 20c0-4 2-7 5-7s5 3 5 7M1 20c0-3 1-5 4-5M23 20c0-3-1-5-4-5"></path>
                  </svg>
                </div>
                <div>
                  <p class="benefitTitle">Reach real people</p>
                  <p class="benefitText">Show up when someone is looking for what you offer.</p>
                </div>
              </div>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="M3 10h18M7 15h4"></path>
                  </svg>
                </div>
                <div>
                  <p class="benefitTitle">Coordinate in one place</p>
                  <p class="benefitText">Keep the people, plan, progress and payment connected in one place.</p>
                </div>
              </div>

              <div class="benefit">
                <div class="benefitIcon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                  </svg>
                </div>
                <div>
                  <p class="benefitTitle">Built for repeat use</p>
                  <p class="benefitText">One network built for repeat use across different kinds of opportunities.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="final" aria-label="Time to FLY">
        <div class="finalInner">
          <img class="finalPhoto" src="/campaign/time-to-fly.png" alt="" aria-hidden="true" />
          <div class="finalCopy">
            <p class="finalKicker">Ready to get started?</p>
            <h2 class="finalTitle">Time to FLY.</h2>
            <p class="finalText">Open the marketplace around you.</p>
            <div class="finalActions">
              <a class="finalBtn primary" href={appStoreUrl} target="_blank" rel="noopener noreferrer">Download FLY</a>
              <a class="finalBtn" href="/info/">Learn more</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footerInner">
        <div>© 2026 {siteName}</div>
        <div class="footerLinks">
          <a href="/">Home</a>
          <a href="/info/">Info</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href={`mailto:${contactEmail}`}>Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
