---
const siteName = "FLY Unlimited";
const contactEmail = "hello@fly-unlimited.com";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";

/*
  PHASE 1.2 — EDITORIAL WEB TRANSLATION
  These are still temporary existing repo photos.
  When the clean final campaign photography is ready, only swap these paths.
*/
const heroPhoto = "/campaign/hero-center-you.png";
const askPhoto = "/campaign/need-something-ask.png";
const marketplacePhoto = "/campaign/marketplace-around-you.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>How FLY Works • {siteName}</title>
    <meta
      name="description"
      content="See how FLY helps you ask for what you need, connect with people around you, and move from idea to done."
    />

    <style>
      :root{
        --black:#090909;
        --white:#f8f6f1;
        --cream:#f3eee5;
        --purple:#b88cf1;
        --mint:#baf0c3;
        --yellow:#f4d95f;
        --coral:#ee8378;
        --blue:#91b8ec;

        --text:#0b0b0b;
        --muted:rgba(11,11,11,.62);
        --hair:rgba(11,11,11,.12);
        --max:1440px;
        --pad:clamp(20px,4vw,68px);
        --ease:cubic-bezier(.2,.8,.2,1);
      }

      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      html,body{margin:0;padding:0;background:var(--white);color:var(--text)}
      body{
        font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        -webkit-font-smoothing:antialiased;
        text-rendering:optimizeLegibility;
        overflow-x:hidden;
      }

      a{color:inherit;text-decoration:none}
      a:focus-visible{
        outline:2px solid #111;
        outline-offset:4px;
      }

      .display{
        margin:0;
        font-family:"Arial Narrow","Helvetica Neue Condensed Bold","Arial",sans-serif;
        font-stretch:condensed;
        font-weight:900;
        text-transform:uppercase;
        letter-spacing:-.06em;
        line-height:.86;
      }

      /* ===== ORIGINAL FLY ICON NAV — LOCKED ===== */
      .topbar{
        position:sticky;
        top:0;
        z-index:50;
        background:rgba(255,255,255,.96);
        border-bottom:1px solid rgba(0,0,0,.06);
      }

      .topbarInner{
        max-width:1120px;
        margin:0 auto;
        padding:10px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
      }

      .brand{
        display:flex;
        align-items:center;
        gap:10px;
        min-height:44px;
      }

      .mascot{
        width:26px;
        height:26px;
        border-radius:10px;
        object-fit:contain;
        display:block;
      }

      .nav{
        display:flex;
        align-items:center;
        gap:10px;
      }

      .navBtn{
        width:42px;
        height:42px;
        display:grid;
        place-items:center;
        border-radius:999px;
        color:rgba(11,12,16,.70);
        transition:background .18s var(--ease),color .18s var(--ease);
      }

      .navBtn:hover{
        background:rgba(0,0,0,.05);
        color:rgba(11,12,16,.92);
      }

      .navBtn.active{
        background:rgba(0,0,0,.08);
        color:rgba(11,12,16,.96);
      }

      .navIcon{
        width:18px;
        height:18px;
        display:block;
        object-fit:contain;
      }

      .navBtn svg{
        width:18px;
        height:18px;
        stroke:currentColor;
        stroke-width:2.2;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      /* ===== SHARED CAMPAIGN SECTION ===== */
      .campaign{
        position:relative;
        min-height:clamp(560px,63vw,760px);
        overflow:hidden;
        isolation:isolate;
        border-bottom:1px solid rgba(255,255,255,.35);
        background:#8d8982;
      }

      .campaign__photo{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        filter:saturate(.62) contrast(.95) brightness(.92) sepia(.07);
        transform:scale(1.01);
        z-index:-3;
      }

      .campaign::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-2;
        pointer-events:none;
      }

      .campaign__inner{
        width:min(100%,var(--max));
        min-height:inherit;
        margin:0 auto;
        padding:clamp(58px,6vw,92px) var(--pad);
        display:grid;
        grid-template-columns:minmax(0,1fr) minmax(330px,.56fr);
        gap:clamp(34px,5vw,84px);
        align-items:center;
      }

      .campaign__copy{
        max-width:760px;
        align-self:center;
      }

      .campaign__kicker{
        margin:0 0 18px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
      }

      .campaign__title{
        font-size:clamp(62px,7.1vw,132px);
        max-width:8ch;
        text-shadow:0 2px 26px rgba(0,0,0,.16);
      }

      .campaign__sub{
        margin:24px 0 0;
        max-width:34rem;
        font-size:clamp(13px,1vw,16px);
        font-weight:800;
        letter-spacing:.14em;
        line-height:1.55;
        text-transform:uppercase;
      }

      .campaign__body{
        margin:22px 0 0;
        max-width:34rem;
        font-size:clamp(16px,1.15vw,19px);
        line-height:1.56;
      }

      .hero{
        min-height:clamp(620px,66vw,820px);
      }

      .hero::before{
        background:
          linear-gradient(90deg,rgba(8,8,8,.72) 0%,rgba(8,8,8,.56) 36%,rgba(8,8,8,.16) 70%,rgba(8,8,8,.04) 100%),
          linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.12));
      }

      .hero .campaign__inner{
        grid-template-columns:minmax(0,1fr) minmax(260px,.54fr);
      }

      .hero .campaign__kicker,
      .hero .campaign__body{color:rgba(255,255,255,.72)}

      .hero .campaign__title{color:#f6efe4}
      .hero .campaign__title .accent{color:var(--yellow)}
      .hero .campaign__sub{color:rgba(255,255,255,.9)}

      .heroActions{
        margin-top:30px;
        display:flex;
        flex-wrap:wrap;
        gap:10px;
      }

      .cta{
        min-height:46px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.38);
        font-size:13px;
        font-weight:760;
        transition:transform .18s var(--ease),background .18s var(--ease);
      }

      .cta:hover{transform:translateY(-1px)}
      .cta.primary{background:#fff;color:#111;border-color:#fff}
      .cta.secondary{background:rgba(0,0,0,.14);color:#fff;backdrop-filter:blur(10px)}

      /* ===== PRODUCT PHONE ===== */
      .productStage{
        justify-self:end;
        align-self:end;
        width:min(100%,360px);
        padding-top:22px;
        display:flex;
        justify-content:flex-end;
      }

      .phone{
        width:min(100%,310px);
        aspect-ratio:9/18.6;
        border-radius:40px 40px 0 0;
        border:6px solid #0b0b0b;
        border-bottom:0;
        background:#fff;
        box-shadow:0 28px 60px rgba(0,0,0,.24);
        overflow:hidden;
        transform:translateY(70px);
      }

      .phone__top{
        height:34px;
        position:relative;
        display:flex;
        align-items:center;
        justify-content:center;
        border-bottom:1px solid rgba(0,0,0,.06);
      }

      .phone__island{
        width:82px;
        height:20px;
        border-radius:999px;
        background:#080808;
      }

      .phone__bar{
        padding:14px 14px 10px;
        display:flex;
        align-items:center;
        justify-content:space-between;
      }

      .phone__brand{
        font-weight:950;
        font-style:italic;
        letter-spacing:-.08em;
        font-size:21px;
      }

      .phone__icons{
        display:flex;
        gap:8px;
        color:#111;
      }

      .phone__icons span{
        width:8px;
        height:8px;
        border-radius:999px;
        border:1.7px solid #111;
        display:block;
      }

      .phone__tabs{
        padding:0 12px 10px;
        display:flex;
        gap:5px;
        overflow:hidden;
      }

      .phone__tab{
        flex:0 0 auto;
        padding:5px 8px;
        border-radius:999px;
        font-size:8px;
        border:1px solid rgba(0,0,0,.08);
        color:rgba(0,0,0,.6);
      }

      .phone__tab.active{
        background:#111;
        color:#fff;
      }

      .phone__grid{
        padding:0 12px 18px;
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:8px;
      }

      .flyCard{
        border:1px solid rgba(0,0,0,.08);
        border-radius:11px;
        overflow:hidden;
        background:#fff;
      }

      .flyCard__media{
        aspect-ratio:1.15/1;
        background:
          linear-gradient(135deg,#cab9a7,#6c6762 58%,#272727);
      }

      .flyCard:nth-child(2) .flyCard__media{
        background:linear-gradient(135deg,#aab0a9,#4c5953 60%,#151515);
      }

      .flyCard:nth-child(3) .flyCard__media{
        background:linear-gradient(135deg,#d5c1ad,#806955 62%,#34271e);
      }

      .flyCard:nth-child(4) .flyCard__media{
        background:linear-gradient(135deg,#b4a9ac,#5d5256 60%,#171717);
      }

      .flyCard__copy{
        padding:7px;
      }

      .flyCard__title{
        font-size:8px;
        font-weight:800;
        line-height:1.2;
      }

      .flyCard__meta{
        margin-top:3px;
        font-size:7px;
        color:rgba(0,0,0,.48);
      }

      /* ===== ASK ===== */
      .ask::before{
        background:
          linear-gradient(90deg,rgba(7,7,7,.72) 0%,rgba(7,7,7,.48) 42%,rgba(7,7,7,.11) 71%,rgba(7,7,7,.02) 100%),
          linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.12));
      }

      .ask .campaign__title{color:var(--purple);max-width:6.4ch}
      .ask .campaign__kicker,
      .ask .campaign__body{color:rgba(255,255,255,.73)}
      .ask .campaign__sub{color:#ddc8ff}

      /* ===== LOOP ===== */
      .loop{
        padding:clamp(86px,9vw,140px) var(--pad);
        background:var(--white);
      }

      .loopInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .loopIntro{
        display:grid;
        grid-template-columns:minmax(0,.72fr) minmax(300px,.28fr);
        gap:50px;
        align-items:end;
        margin-bottom:50px;
      }

      .loopKicker{
        margin:0 0 14px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(11,11,11,.45);
      }

      .loopTitle{
        margin:0;
        max-width:10ch;
        font-size:clamp(42px,5vw,82px);
        line-height:.92;
        letter-spacing:-.05em;
        font-weight:850;
      }

      .loopBody{
        margin:0;
        max-width:31rem;
        color:var(--muted);
        font-size:17px;
        line-height:1.55;
      }

      .loopGrid{
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .loopItem{
        min-height:260px;
        padding:26px 22px 28px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
      }

      .loopItem:last-child{border-right:0}

      .loopNum{
        font-size:10px;
        font-weight:800;
        letter-spacing:.18em;
        color:rgba(0,0,0,.38);
      }

      .loopWord{
        margin:0;
        font-family:"Arial Narrow","Helvetica Neue Condensed Bold","Arial",sans-serif;
        font-weight:900;
        letter-spacing:-.06em;
        line-height:.85;
        text-transform:uppercase;
        font-size:clamp(42px,4.1vw,72px);
      }

      .loopText{
        margin:14px 0 0;
        max-width:17rem;
        color:var(--muted);
        font-size:15px;
        line-height:1.5;
      }

      .loopItem:nth-child(1) .loopWord{color:#9774d1}
      .loopItem:nth-child(2) .loopWord{color:#6b9f75}
      .loopItem:nth-child(3) .loopWord{color:#c6a63d}
      .loopItem:nth-child(4) .loopWord{color:#d2786f}

      /* ===== MARKETPLACE ===== */
      .marketplace::before{
        background:
          linear-gradient(90deg,rgba(5,8,6,.7) 0%,rgba(5,8,6,.48) 40%,rgba(5,8,6,.11) 70%,rgba(5,8,6,.01) 100%),
          linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.1));
      }

      .marketplace .campaign__title{
        color:var(--mint);
        max-width:7.3ch;
      }

      .marketplace .campaign__kicker,
      .marketplace .campaign__body{color:rgba(255,255,255,.72)}
      .marketplace .campaign__sub{color:#d5f7dc}

      /* Map mock inside phone */
      .mapPhone{
        position:relative;
      }

      .mapArea{
        margin:0 12px;
        height:240px;
        border-radius:12px;
        overflow:hidden;
        position:relative;
        background:
          linear-gradient(90deg,transparent 49%,rgba(110,120,115,.18) 50%,transparent 51%),
          linear-gradient(0deg,transparent 49%,rgba(110,120,115,.18) 50%,transparent 51%),
          linear-gradient(135deg,#e7ece8,#d9e0da);
        background-size:48px 48px,48px 48px,100% 100%;
      }

      .mapRoad{
        position:absolute;
        width:150%;
        height:8px;
        left:-20%;
        top:48%;
        background:#fff;
        transform:rotate(-22deg);
        box-shadow:0 0 0 1px rgba(0,0,0,.04);
      }

      .pin{
        position:absolute;
        width:30px;
        height:30px;
        border-radius:999px;
        background:#fff;
        border:2px solid #fff;
        box-shadow:0 3px 12px rgba(0,0,0,.18);
      }

      .pin::after{
        content:"";
        position:absolute;
        inset:5px;
        border-radius:999px;
        background:#4a514c;
      }

      .pin.p1{left:20%;top:24%}
      .pin.p2{right:18%;top:18%}
      .pin.p3{left:42%;top:52%}
      .pin.p4{right:23%;bottom:15%}

      .me{
        position:absolute;
        left:50%;
        top:46%;
        width:22px;
        height:22px;
        transform:translate(-50%,-50%);
        border-radius:999px;
        background:#4a9cff;
        border:5px solid rgba(255,255,255,.82);
        box-shadow:0 0 0 8px rgba(74,156,255,.2);
      }

      .mapResult{
        margin:10px 12px 0;
        padding:10px;
        border:1px solid rgba(0,0,0,.08);
        border-radius:12px;
        display:grid;
        grid-template-columns:46px 1fr;
        gap:9px;
      }

      .mapResult__img{
        border-radius:8px;
        background:linear-gradient(135deg,#cbb49e,#66584d);
      }

      .mapResult__title{
        font-size:9px;
        font-weight:800;
      }

      .mapResult__meta{
        margin-top:4px;
        font-size:7px;
        color:rgba(0,0,0,.5);
      }


      /* ===== PHASE 1.3 — CORE FEATURE CHAPTERS ===== */
      .opportunity::before{
        background:
          linear-gradient(90deg,rgba(7,7,7,.72) 0%,rgba(7,7,7,.47) 43%,rgba(7,7,7,.13) 72%,rgba(7,7,7,.02) 100%),
          linear-gradient(180deg,rgba(0,0,0,.03),rgba(0,0,0,.12));
      }

      .opportunity .campaign__title{
        color:var(--coral);
        max-width:7.6ch;
      }

      .opportunity .campaign__kicker,
      .opportunity .campaign__body{
        color:rgba(255,255,255,.74);
      }

      .opportunity .campaign__sub{
        color:#ffd3cf;
      }

      .featurePanel{
        width:min(100%,350px);
        justify-self:end;
        align-self:center;
        background:rgba(255,255,255,.96);
        color:#111;
        border-radius:22px;
        border:1px solid rgba(255,255,255,.55);
        box-shadow:0 24px 60px rgba(0,0,0,.22);
        overflow:hidden;
        backdrop-filter:blur(12px);
      }

      .featurePanel__head{
        padding:14px 16px 12px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
        border-bottom:1px solid rgba(0,0,0,.07);
      }

      .featurePanel__title{
        font-size:12px;
        font-weight:850;
        letter-spacing:-.02em;
      }

      .featurePanel__meta{
        font-size:9px;
        color:rgba(0,0,0,.48);
      }

      .messageThread{
        padding:14px;
        display:grid;
        gap:10px;
      }

      .messageRow{
        display:flex;
        gap:9px;
        align-items:flex-end;
      }

      .messageRow.me{
        justify-content:flex-end;
      }

      .avatarDot{
        width:28px;
        height:28px;
        border-radius:999px;
        flex:0 0 28px;
        background:linear-gradient(135deg,#d2b39c,#6d5548);
      }

      .bubble{
        max-width:78%;
        padding:9px 11px;
        border-radius:14px 14px 14px 4px;
        background:#f2f2f2;
        font-size:9px;
        line-height:1.4;
      }

      .messageRow.me .bubble{
        background:#c9a5ef;
        border-radius:14px 14px 4px 14px;
      }

      .attachmentThumb{
        width:100%;
        height:72px;
        border-radius:10px;
        margin-top:7px;
        background:linear-gradient(135deg,#b7a89f,#5a4f49 58%,#1d1d1d);
      }

      .livetime::before{
        background:
          linear-gradient(90deg,rgba(5,5,5,.76) 0%,rgba(5,5,5,.5) 44%,rgba(5,5,5,.12) 74%,rgba(5,5,5,.02) 100%),
          linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.12));
      }

      .livetime .campaign__title{
        color:var(--yellow);
        max-width:6.4ch;
      }

      .livetime .campaign__kicker,
      .livetime .campaign__body{
        color:rgba(255,255,255,.74);
      }

      .livetime .campaign__sub{
        color:#fff0a9;
      }

      .liveSteps{
        padding:14px 16px 16px;
        display:grid;
        gap:14px;
      }

      .liveStep{
        display:grid;
        grid-template-columns:28px minmax(0,1fr);
        gap:10px;
        align-items:center;
      }

      .liveStep__icon{
        width:28px;
        height:28px;
        border-radius:999px;
        border:1px solid rgba(0,0,0,.12);
        display:grid;
        place-items:center;
        font-size:10px;
        font-weight:900;
      }

      .liveStep.done .liveStep__icon{
        background:#dff3e3;
        border-color:#8fc79c;
      }

      .liveStep.active .liveStep__icon{
        background:#edf3ff;
        border-color:#93afe1;
      }

      .liveStep__label{
        font-size:10px;
        font-weight:800;
      }

      .liveStep__sub{
        margin-top:2px;
        font-size:8px;
        color:rgba(0,0,0,.46);
      }

      .liveButton{
        margin:4px 16px 16px;
        min-height:40px;
        border-radius:10px;
        display:flex;
        align-items:center;
        justify-content:center;
        background:#111;
        color:#fff;
        font-size:10px;
        font-weight:850;
      }

      .payment::before{
        background:
          linear-gradient(90deg,rgba(7,7,7,.7) 0%,rgba(7,7,7,.45) 43%,rgba(7,7,7,.11) 72%,rgba(7,7,7,.02) 100%),
          linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.12));
      }

      .payment .campaign__title{
        color:var(--coral);
        max-width:6.3ch;
      }

      .payment .campaign__kicker,
      .payment .campaign__body{
        color:rgba(255,255,255,.74);
      }

      .payment .campaign__sub{
        color:#ffd6d1;
      }

      .payBody{
        padding:14px 16px 18px;
      }

      .payTabs{
        display:flex;
        gap:6px;
        flex-wrap:wrap;
      }

      .payTab{
        padding:6px 9px;
        border-radius:999px;
        background:#f1f1f1;
        font-size:8px;
        font-weight:750;
      }

      .payTab.active{
        background:#111;
        color:#fff;
      }

      .payAmount{
        margin-top:22px;
        font-size:44px;
        line-height:1;
        font-weight:900;
        letter-spacing:-.055em;
      }

      .payUnit{
        margin-left:5px;
        font-size:11px;
        font-weight:650;
        color:rgba(0,0,0,.48);
        letter-spacing:0;
      }

      .earlyPay{
        margin-top:18px;
        padding-top:14px;
        border-top:1px solid rgba(0,0,0,.08);
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
      }

      .earlyPay__title{
        font-size:10px;
        font-weight:850;
      }

      .earlyPay__sub{
        margin-top:3px;
        font-size:8px;
        color:rgba(0,0,0,.47);
      }

      .toggle{
        width:38px;
        height:22px;
        padding:3px;
        border-radius:999px;
        background:#c9a5ef;
        display:flex;
        justify-content:flex-end;
      }

      .toggle::after{
        content:"";
        width:16px;
        height:16px;
        border-radius:999px;
        background:#fff;
        box-shadow:0 1px 4px rgba(0,0,0,.18);
      }

      .closing{
        min-height:clamp(540px,58vw,760px);
        position:relative;
        overflow:hidden;
        display:grid;
        place-items:center;
        isolation:isolate;
        background:#26221f;
      }

      .closing__photo{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        filter:saturate(.58) contrast(.95) brightness(.72) sepia(.05);
        z-index:-2;
      }

      .closing::after{
        content:"";
        position:absolute;
        inset:0;
        background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.38));
        z-index:-1;
      }

      .closing__content{
        text-align:center;
        padding:60px 20px;
        color:#fff;
      }

      .closing__logo{
        width:clamp(160px,18vw,300px);
        height:auto;
        display:block;
        margin:0 auto;
        border-radius:0;
      }

      .closing__tag{
        margin:18px 0 0;
        font-size:clamp(24px,2.4vw,38px);
        font-weight:450;
        letter-spacing:-.03em;
      }

      .closing__cta{
        margin-top:28px;
        min-height:46px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        background:#fff;
        color:#111;
        font-size:13px;
        font-weight:800;
      }

      @media(max-width:720px){
        .featurePanel{
          width:270px;
          justify-self:center;
        }

        .opportunity .campaign__inner,
        .livetime .campaign__inner,
        .payment .campaign__inner{
          padding-bottom:0;
        }

        .opportunity .campaign__copy,
        .livetime .campaign__copy,
        .payment .campaign__copy{
          padding-bottom:26px;
        }

        .closing{
          min-height:680px;
        }
      }



      /* ===== PHASE 1.4 — PURE CAMPAIGN / NO APP GRAPHICS ===== */
      .productStage,
      .featurePanel{
        display:none !important;
      }

      .campaign__inner{
        grid-template-columns:minmax(0,760px) minmax(0,1fr);
      }

      .hero .campaign__inner{
        grid-template-columns:minmax(0,760px) minmax(0,1fr);
      }

      .benefits,
      .uses{
        padding:clamp(88px,9vw,144px) var(--pad);
        background:var(--white);
      }

      .uses{
        background:#f0ece4;
      }

      .benefits__inner,
      .uses__inner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .sectionEyebrow{
        margin:0 0 16px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(11,11,11,.46);
      }

      .sectionHeadline{
        margin:0;
        max-width:10ch;
        font-size:clamp(44px,5.2vw,86px);
        line-height:.92;
        letter-spacing:-.052em;
        font-weight:850;
      }

      .sectionIntro{
        margin:24px 0 0;
        max-width:44rem;
        color:var(--muted);
        font-size:clamp(17px,1.15vw,19px);
        line-height:1.6;
      }

      .benefitGrid{
        margin-top:clamp(46px,6vw,78px);
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .benefit{
        min-height:270px;
        padding:26px 24px 30px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
      }

      .benefit:last-child{
        border-right:0;
      }

      .benefitNum{
        font-size:10px;
        font-weight:800;
        letter-spacing:.18em;
        color:rgba(0,0,0,.38);
      }

      .benefitTitle{
        margin:0;
        font-size:clamp(24px,2.25vw,36px);
        line-height:1;
        letter-spacing:-.045em;
        font-weight:850;
      }

      .benefitText{
        margin:14px 0 0;
        max-width:17rem;
        color:var(--muted);
        font-size:15px;
        line-height:1.55;
      }

      .usesGrid{
        margin-top:clamp(42px,5vw,68px);
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:1px;
        background:rgba(11,11,11,.11);
        border:1px solid rgba(11,11,11,.11);
      }

      .use{
        min-height:190px;
        padding:26px;
