      .useType{
        font-size:10px;
        font-weight:800;
        letter-spacing:.17em;
        text-transform:uppercase;
        color:rgba(11,11,11,.42);
      }

      .useText{
        margin:30px 0 0;
        font-size:clamp(22px,2vw,30px);
        line-height:1.08;
        letter-spacing:-.035em;
        font-weight:760;
        max-width:14ch;
      }

      .usesNote{
        margin:28px 0 0;
        max-width:42rem;
        color:var(--muted);
        font-size:15px;
        line-height:1.6;
      }

      @media(max-width:1000px){
        .campaign__inner,
        .hero .campaign__inner{
          grid-template-columns:minmax(0,720px) minmax(0,1fr);
        }

        .benefitGrid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .benefit:nth-child(2){
          border-right:0;
        }

        .benefit:nth-child(-n+2){
          border-bottom:1px solid var(--hair);
        }

        .usesGrid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }
      }

      @media(max-width:720px){
        .campaign__inner,
        .hero .campaign__inner{
          grid-template-columns:1fr;
        }

        .benefits,
        .uses{
          padding:72px 18px 82px;
        }

        .benefitGrid,
        .usesGrid{
          grid-template-columns:1fr;
        }

        .benefit{
          min-height:220px;
          border-right:0;
          border-bottom:1px solid var(--hair);
          padding:22px 0 24px;
        }

        .benefit:nth-child(-n+2){
          border-bottom:1px solid var(--hair);
        }

        .use{
          min-height:160px;
          padding:22px;
        }
      }



      /* ===== PHASE 1.5 — PRACTICAL HOW-TO + FAQ ===== */
      .guide{
        padding:clamp(88px,9vw,144px) var(--pad);
        background:#fff;
      }

      .guide__inner,
      .faq__inner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .guide__intro{
        display:grid;
        grid-template-columns:minmax(0,.7fr) minmax(300px,.3fr);
        gap:48px;
        align-items:end;
        margin-bottom:clamp(44px,6vw,72px);
      }

      .guide__eyebrow,
      .faq__eyebrow{
        margin:0 0 16px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(11,11,11,.46);
      }

      .guide__title,
      .faq__title{
        margin:0;
        max-width:10ch;
        font-size:clamp(44px,5.2vw,84px);
        line-height:.92;
        letter-spacing:-.052em;
        font-weight:850;
      }

      .guide__lead{
        margin:0;
        max-width:31rem;
        color:var(--muted);
        font-size:clamp(17px,1.15vw,19px);
        line-height:1.6;
      }

      .guide__steps{
        border-top:1px solid var(--hair);
      }

      .guideStep{
        display:grid;
        grid-template-columns:90px minmax(220px,.32fr) minmax(0,.68fr);
        gap:24px;
        align-items:start;
        padding:28px 0 30px;
        border-bottom:1px solid var(--hair);
      }

      .guideStep__num{
        font-size:12px;
        font-weight:850;
        letter-spacing:.16em;
        color:rgba(11,11,11,.4);
      }

      .guideStep__title{
        margin:0;
        font-size:clamp(24px,2.25vw,34px);
        line-height:1;
        letter-spacing:-.045em;
        font-weight:850;
      }

      .guideStep__text{
        margin:0;
        max-width:46rem;
        color:var(--muted);
        font-size:16px;
        line-height:1.62;
      }

      .guideStep__text strong{
        color:rgba(11,11,11,.86);
      }

      .faq{
        padding:clamp(84px,8vw,132px) var(--pad);
        background:#f2eee7;
      }

      .faq__top{
        margin-bottom:clamp(38px,5vw,62px);
      }

      .faq__title{
        max-width:9ch;
      }

      .faqList{
        border-top:1px solid rgba(11,11,11,.14);
      }

      .faqItem{
        border-bottom:1px solid rgba(11,11,11,.14);
      }

      .faqItem summary{
        list-style:none;
        cursor:pointer;
        min-height:76px;
        display:grid;
        grid-template-columns:minmax(0,1fr) 32px;
        gap:20px;
        align-items:center;
        font-size:clamp(18px,1.5vw,23px);
        font-weight:780;
        letter-spacing:-.025em;
      }

      .faqItem summary::-webkit-details-marker{
        display:none;
      }

      .faqPlus{
        width:28px;
        height:28px;
        display:grid;
        place-items:center;
        border:1px solid rgba(11,11,11,.18);
        border-radius:999px;
        font-size:18px;
        font-weight:400;
        transition:transform .18s var(--ease);
      }

      .faqItem[open] .faqPlus{
        transform:rotate(45deg);
      }

      .faqAnswer{
        margin:0 0 26px;
        max-width:52rem;
        color:var(--muted);
        font-size:16px;
        line-height:1.65;
      }

      @media(max-width:900px){
        .guide__intro{
          grid-template-columns:1fr;
          gap:20px;
        }

        .guideStep{
          grid-template-columns:68px minmax(0,1fr);
          gap:18px;
        }

        .guideStep__text{
          grid-column:2;
          margin-top:-4px;
        }
      }

      @media(max-width:620px){
        .guide,
        .faq{
          padding-left:18px;
          padding-right:18px;
        }

        .guideStep{
          grid-template-columns:46px minmax(0,1fr);
          padding:24px 0 26px;
        }

        .guideStep__num{
          font-size:11px;
        }

        .guideStep__title{
          font-size:26px;
        }

        .guideStep__text{
          font-size:15.5px;
        }

        .faqItem summary{
          min-height:70px;
          font-size:18px;
        }
      }



      /* ===== PHASE 1.6 — FLOW POLISH ===== */
      .guide{
        background:#fbfaf7;
      }

      .guide__title{
        max-width:11ch;
      }

      .guideStep{
        padding-top:24px;
        padding-bottom:26px;
      }

      .benefits{
        background:#fff;
      }

      .uses{
        background:#f3efe8;
      }

      .faq{
        background:#ebe6de;
      }

      /* Keep campaign chapters cinematic and concise. */
      .campaign__body{
        max-width:31rem;
      }

      .campaign__sub{
        max-width:34rem;
      }

      /* No product visuals during brand phase. */
      .productStage,
      .featurePanel,
      .phone,
      .mapPhone{
        display:none !important;
      }

      @media(max-width:720px){
        .guideStep{
          padding-top:22px;
          padding-bottom:24px;
        }
      }



      /* ===== PHASE 1.7 — CAMPAIGN TIGHTEN ===== */

      .campaign{
        min-height:clamp(500px,54vw,690px);
      }

      .campaign__inner{
        padding-top:clamp(52px,5.5vw,82px);
        padding-bottom:clamp(52px,5.5vw,82px);
      }

      .campaign__copy{
        max-width:700px;
      }

      .campaign__sub{
        margin-top:22px;
        max-width:31rem;
      }

      .hero{
        min-height:clamp(620px,66vw,820px);
      }

      .closing__logo{
        filter:brightness(0) invert(1);
      }

      @media(max-width:720px){
        .campaign{
          min-height:700px;
        }

        .campaign__inner,
        .hero .campaign__inner{
          min-height:700px;
        }

        .hero{
          min-height:760px;
        }

        .hero .campaign__inner{
          min-height:760px;
        }
      }



      /* ===== PHASE 1.8 — BANNER SYSTEM ===== */

      /*
        Lock the campaign banners into one repeatable visual system:
        full-bleed photography, lower-left editorial copy, restrained color,
        and no product screenshots.
      */

      .campaign{
        min-height:clamp(520px,56vw,710px);
      }

      .campaign__inner{
        min-height:inherit;
        display:flex;
        align-items:flex-end;
        justify-content:flex-start;
        padding-top:clamp(52px,6vw,88px);
        padding-bottom:clamp(54px,6.2vw,92px);
      }

      .campaign__copy{
        width:min(100%,760px);
        max-width:760px;
      }

      .campaign__kicker{
        margin-bottom:14px;
        color:rgba(255,255,255,.62) !important;
      }

      .campaign__title{
        max-width:7.4ch;
        font-size:clamp(58px,7.2vw,128px);
        line-height:.84;
        letter-spacing:-.062em;
        text-shadow:0 2px 24px rgba(0,0,0,.18);
      }

      .campaign__sub{
        margin-top:22px;
        max-width:35rem;
        font-size:clamp(13px,1.05vw,16px);
        line-height:1.48;
        letter-spacing:.15em;
      }

      .hero .campaign__inner{
        display:flex;
        align-items:center;
      }

      .hero .campaign__copy{
        padding-top:8px;
        padding-bottom:8px;
      }

      .hero .campaign__title{
        max-width:8ch;
        font-size:clamp(62px,7.4vw,134px);
      }

      .hero .campaign__body{
        margin-top:20px;
        max-width:31rem;
      }

      .ask .campaign__title{color:var(--purple)}
      .marketplace .campaign__title{color:var(--mint)}
      .opportunity .campaign__title{color:var(--coral)}
      .livetime .campaign__title{color:var(--blue)}
      .payment .campaign__title{color:var(--coral)}

      .ask::before,
      .marketplace::before,
      .opportunity::before,
      .livetime::before,
      .payment::before{
        background:
          linear-gradient(
            90deg,
            rgba(7,7,7,.70) 0%,
            rgba(7,7,7,.48) 34%,
            rgba(7,7,7,.20) 58%,
            rgba(7,7,7,.05) 78%,
            rgba(7,7,7,.00) 100%
          ),
          linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.10));
      }

      .closing__sub{
        margin:10px auto 0;
        max-width:28rem;
        color:rgba(255,255,255,.72);
        font-size:14px;
        line-height:1.5;
      }

      .productStage,
      .featurePanel,
      .phone,
      .mapPhone{
        display:none !important;
      }

      @media(max-width:720px){
        .campaign{
          min-height:680px;
        }

        .campaign__inner{
          min-height:680px;
          padding:52px 18px 48px;
          align-items:flex-end;
        }

        .hero{
          min-height:760px;
        }

        .hero .campaign__inner{
          min-height:760px;
          align-items:flex-end;
          padding-bottom:58px;
        }

        .campaign__title,
        .hero .campaign__title{
          font-size:clamp(52px,16vw,78px);
          max-width:7ch;
        }

        .campaign__sub{
          margin-top:18px;
        }
      }



      /* ===== PHASE 1.9C — COPY + SPACING LOCK FIX ===== */

      .brandProof{
        padding:clamp(82px,8vw,128px) var(--pad);
        background:#f7f5f0;
      }

      .brandProof__inner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .brandProof__top{
        display:grid;
        grid-template-columns:minmax(0,.68fr) minmax(300px,.32fr);
        gap:48px;
        align-items:end;
      }

      .brandProof__eyebrow{
        margin:0 0 14px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(11,11,11,.44);
      }

      .brandProof__title{
        margin:0;
        max-width:8ch;
        font-size:clamp(44px,5.1vw,82px);
        line-height:.92;
        letter-spacing:-.052em;
        font-weight:850;
      }

      .brandProof__intro{
        margin:0;
        max-width:31rem;
        color:var(--muted);
        font-size:clamp(17px,1.12vw,19px);
        line-height:1.58;
      }

      .brandProof__grid{
        margin-top:clamp(42px,5vw,66px);
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .brandProof__item{
        min-height:235px;
        padding:24px 22px 26px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
      }

      .brandProof__item:last-child{border-right:0}

      .brandProof__num{
        font-size:10px;
        font-weight:800;
        letter-spacing:.18em;
        color:rgba(11,11,11,.36);
      }

      .brandProof__itemTitle{
        margin:0;
        font-size:clamp(22px,2vw,31px);
        line-height:1;
        letter-spacing:-.043em;
        font-weight:850;
      }

      .brandProof__text{
        margin:12px 0 0;
        max-width:17rem;
        color:var(--muted);
        font-size:14.5px;
        line-height:1.52;
      }

      .brandProof__examples{
        padding-top:22px;
        display:flex;
        flex-wrap:wrap;
        gap:8px;
      }

      .brandProof__examples span{
        padding:7px 11px;
        border:1px solid rgba(11,11,11,.13);
        border-radius:999px;
        font-size:11px;
        font-weight:720;
        letter-spacing:.02em;
        color:rgba(11,11,11,.62);
      }

      .faq{
        padding-top:clamp(68px,6.5vw,102px);
        padding-bottom:clamp(68px,6.5vw,102px);
      }

      .faq__top{
        margin-bottom:clamp(24px,3.5vw,42px);
      }

      .faqItem summary{
        min-height:64px;
      }

      .faqAnswer{
        margin-bottom:20px;
        font-size:15.5px;
        line-height:1.6;
      }

      @media(max-width:1000px){
        .brandProof__top{
          grid-template-columns:1fr;
          gap:18px;
        }

        .brandProof__grid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .brandProof__item:nth-child(2){border-right:0}
        .brandProof__item:nth-child(-n+2){border-bottom:1px solid var(--hair)}
      }

      @media(max-width:620px){
        .brandProof{
          padding:68px 18px 76px;
        }

        .brandProof__grid{
          grid-template-columns:1fr;
        }

        .brandProof__item{
          min-height:190px;
          padding:20px 0 22px;
          border-right:0;
          border-bottom:1px solid var(--hair);
        }

        .brandProof__examples{
          gap:6px;
        }

        .faq{
          padding-top:62px;
          padding-bottom:70px;
        }

        .faqItem summary{
          min-height:60px;
        }
