---
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const siteName = "FLY Unlimited";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";

const stages = [
  {
    num: "01",
    title: "Plan",
    text: "Keep goals, materials and key details attached before the FLY begins.",
  },
  {
    num: "02",
    title: "Progress",
    text: "Follow the shared plan and keep the next action clear for both sides.",
  },
  {
    num: "03",
    title: "Share",
    text: "Add updates, photos, files and proof where the work is happening.",
  },
  {
    num: "04",
    title: "Complete",
    text: "Review the result, confirm the finish and close the FLY together.",
  },
];

const modes = [
  {
    label: "Service",
    title: "Work with a plan.",
    text: "Goals, materials, information, updates and proof stay attached as the service moves.",
  },
  {
    label: "Delivery",
    title: "From pickup to delivered.",
    text: "Pickup, directions, handoff and delivery confirmation stay inside the same flow.",
  },
  {
    label: "Transport",
    title: "From here to there — and back.",
    text: "One-way, return and multi-stop routes can keep each leg and interval clear.",
  },
  {
    label: "Collab",
    title: "Keep everyone moving together.",
    text: "Shared goals, files, updates and context stay attached to the collaboration.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LiveTime • {siteName}</title>
    <meta
      name="description"
      content="LiveTime is where a FLY moves from connection to completion — keeping the plan, progress, files, directions, proof and confirmations together."
    />
    <meta name="theme-color" content="#ffffff" />
      <link rel="stylesheet" href="/fly-refinement-v1.css" />
      <!-- FLY SITE ICONS V3 -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/fly-site-icon-v3.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/fly-site-icon-32-v3.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/fly-site-icon-48-v3.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/fly-site-icon-180-v3.png" />
  </head>

  <body class="siteShellPage page-livetime">
    <SiteNav />

    <main>
      <section class="hero" aria-labelledby="livetime-title">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">LiveTime</p>
            <h1 id="livetime-title">
              Where the <span>FLY happens.</span>
            </h1>
            <p class="hero__lead">
              Once you connect, LiveTime gives both sides one shared place for the
              plan, progress, files, directions, updates and completion while the FLY
              is actually happening.
            </p>

            <div class="hero__actions">
              <a
                class="button button--dark"
                href={appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
              </a>
              <a class="button button--light" href="/how-it-works/">
                See how FLY works
              </a>
            </div>
          </div>

          <div class="hero__visual" aria-label="LiveTime product view">
            <div class="hero__halo" aria-hidden="true"></div>

            <div class="liveCard">
              <div class="liveCard__head">
                <div>
                  <span>LiveTime</span>
                  <strong>In progress</strong>
                </div>
                <div class="liveCard__status" aria-hidden="true"></div>
              </div>

              <div class="liveCard__title">
                <span>Today’s FLY</span>
                <strong>Rooftop event photos</strong>
              </div>

              <div class="liveCard__rail" aria-label="LiveTime progress">
                <div class="is-done"><span>✓</span><small>Plan</small></div>
                <div class="is-active"><span>2</span><small>In progress</small></div>
                <div><span>3</span><small>Review</small></div>
                <div><span>4</span><small>Complete</small></div>
              </div>

              <div class="liveCard__tasks">
                <article>
                  <span class="liveCard__taskIcon">01</span>
                  <div>
                    <strong>Follow the plan</strong>
                    <p>Goals and key details stay with the FLY.</p>
                  </div>
                </article>

                <article>
                  <span class="liveCard__taskIcon">02</span>
                  <div>
                    <strong>Share progress</strong>
                    <p>Add updates, photos and files as it happens.</p>
                  </div>
                </article>

                <article>
                  <span class="liveCard__taskIcon">03</span>
                  <div>
                    <strong>Confirm the finish</strong>
                    <p>Review what happened and complete together.</p>
                  </div>
                </article>
              </div>
            </div>

            <span class="floatTag floatTag--one">Goals</span>
            <span class="floatTag floatTag--two">Photos</span>
            <span class="floatTag floatTag--three">Files</span>
            <span class="floatTag floatTag--four">Directions</span>
          </div>
        </div>
      </section>

      <section class="statement" aria-labelledby="statement-title">
        <div class="statement__inner">
          <p class="eyebrow">From connection to completion</p>
          <h2 id="statement-title">
            A marketplace should not disappear the moment the work begins.
          </h2>

          <p>
            Once a host chooses someone, LiveTime gives both sides a shared place
            to follow the plan, show progress and carry the FLY through completion.
          </p>
        </div>
      </section>

      <section class="productShot" aria-labelledby="product-shot-title">
        <div class="productShot__inner">
          <div class="productShot__head">
            <div>
              <p class="eyebrow">One shared flow</p>
              <h2 id="product-shot-title">Yes → in progress → done.</h2>
            </div>

            <p>
              Both sides can see what happens next, what changed, and when the
              FLY is complete.
            </p>
          </div>

          <div class="productShot__frame">
            <img
              src="/campaign/livetime-yes-to-done.png"
              alt="LiveTime product visual showing a FLY moving from yes to in progress to done."
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>

      <section class="stages" aria-labelledby="stages-title">
        <div class="stages__inner">
          <div class="stages__head">
            <p class="eyebrow">The shared work</p>
            <h2 id="stages-title">Keep the FLY together.</h2>
          </div>

          <div class="stages__grid">
            {stages.map((stage) => (
              <article>
                <span>{stage.num}</span>
                <div>
                  <h3>{stage.title}</h3>
                  <p>{stage.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="adaptive" aria-labelledby="adaptive-title">
        <div class="adaptive__inner">
          <div class="adaptive__head">
            <p class="eyebrow">Built around the FLY</p>
            <h2 id="adaptive-title">The work changes. LiveTime changes with it.</h2>
            <p>
              A delivery does not happen like a photo shoot. A ride does not happen
              like a collaboration. LiveTime changes with the FLY, surfacing the
              context each experience needs.
            </p>
          </div>

          <div class="adaptive__grid">
            {modes.map((mode, index) => (
              <article class:list={["modeCard", index === 1 && "modeCard--dark"]}>
                <span>{mode.label}</span>
                <h3>{mode.title}</h3>
                <p>{mode.text}</p>

                <div class="modeCard__visual" aria-hidden="true">
                  {index === 0 && (
                    <>
                      <i></i><i></i><i></i>
                    </>
                  )}
                  {index === 1 && (
                    <svg viewBox="0 0 260 100">
                      <path d="M18 72 C70 20, 108 88, 154 43 S221 51, 242 17"></path>
                      <circle cx="18" cy="72" r="7"></circle>
                      <circle cx="242" cy="17" r="7"></circle>
                    </svg>
                  )}
                  {index === 2 && (
                    <div class="routeStops">
                      <i></i><b></b><i></i><b></b><i></i>
                    </div>
                  )}
                  {index === 3 && (
                    <div class="people">
                      <i></i><i></i><i></i>
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>


      <section class="finish" aria-labelledby="finish-title">
        <div class="finish__inner">
          <div class="finish__copy">
            <p class="eyebrow">The finish matters</p>
            <h2 id="finish-title">Done should mean done.</h2>
            <p>
              Instead of ending in an ambiguous message, both sides can review
              what happened, confirm completion and leave the FLY with a clear ending.
            </p>
          </div>

          <div class="finish__card">
            <div class="finish__mark" aria-hidden="true">✓</div>
            <span>FLY completed</span>
            <strong>Everything stays with the FLY.</strong>
          </div>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__inner">
          <img class="closing__bird" src="/brand/fly-bird-filled.svg" alt="" aria-hidden="true" />
          <p class="eyebrow">LiveTime by FLY</p>
          <h2 id="closing-title">Connect. Then make it happen.</h2>
          <p>Start with the Ask. LiveTime carries the FLY from connection to completion.</p>

          <div class="closing__actions">
            <a
              class="button button--dark"
              href={appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="downloadFlyBird" aria-hidden="true"></span>Download FLY
            </a>
            <a class="button button--light" href="/explore/">Explore FLY</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root{
    --black:#090909;
    --ink:#111;
    --muted:#6e6e73;
    --line:rgba(17,17,17,.12);
    --panel:#f5f5f7;
    --purple:#b88cf1;
    --max:1240px;
    --pad:clamp(20px,4vw,64px);
  }

  *{box-sizing:border-box}

  html{
    margin:0;
    padding:0;
    scroll-behavior:smooth;
    background:#fff;
  }

  body{
    margin:0;
    padding:0;
    background:#fff;
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    overflow-x:hidden;
  }

  a{color:inherit}

  .eyebrow{
    margin:0 0 16px;
    color:#86868b;
    font-size:10px;
    line-height:1;
    font-weight:800;
    letter-spacing:.18em;
    text-transform:uppercase;
  }

  .hero{
    padding:clamp(54px,6vw,92px) var(--pad) clamp(66px,7vw,108px);
    background:#fff;
    overflow:hidden;
  }

  .hero__inner{
    width:min(100%,var(--max));
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,.88fr) minmax(460px,.82fr);
    gap:clamp(58px,8vw,124px);
    align-items:center;
  }

  .hero h1{
    margin:0;
    max-width:8.6ch;
    font-size:clamp(68px,7.4vw,116px);
    line-height:.88;
    letter-spacing:-.066em;
    font-weight:760;
  }

  .hero h1 span{
    display:block;
    color:#9a9a9e;
  }

  .hero__lead{
    margin:28px 0 0;
    max-width:37rem;
    color:var(--muted);
    font-size:clamp(18px,1.5vw,22px);
    line-height:1.5;
    letter-spacing:-.018em;
  }

  .hero__actions,
  .closing__actions{
    margin-top:32px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }

  .button{
    min-height:46px;
    padding:0 19px;
    border-radius:999px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-size:13px;
    font-weight:760;
  }

  .button--dark{background:#0a0a0a;color:#fff}
  .button--light{background:#fff;color:#111;border:1px solid rgba(10,10,10,.12)}

  .hero__visual{
    position:relative;
    min-height:560px;
    display:grid;
    place-items:center;
  }

  .hero__halo{
    position:absolute;
    width:540px;
    height:540px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(184,140,241,.25),rgba(184,140,241,0) 67%);
  }

  .liveCard{
    position:relative;
    z-index:2;
    width:min(100%,430px);
    min-height:485px;
    padding:25px;
    border-radius:34px;
    background:#0a0a0a;
    color:#fff;
    box-shadow:0 36px 90px rgba(0,0,0,.24);
    transform:rotate(1.8deg);
  }

  .liveCard__head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
  }

  .liveCard__head > div:first-child{
    display:flex;
    flex-direction:column;
    gap:5px;
  }

  .liveCard__head span,
  .liveCard__title span{
    color:rgba(255,255,255,.42);
    font-size:10px;
    font-weight:800;
    letter-spacing:.14em;
    text-transform:uppercase;
  }

  .liveCard__head strong{
    font-size:14px;
    font-weight:700;
  }

  .liveCard__status{
    width:10px;
    height:10px;
    margin-top:4px;
    border-radius:50%;
    background:#b88cf1;
    box-shadow:0 0 0 6px rgba(184,140,241,.12);
  }

  .liveCard__title{
    margin-top:62px;
    display:flex;
    flex-direction:column;
    gap:8px;
  }

  .liveCard__title strong{
    max-width:9ch;
    font-size:37px;
    line-height:.98;
    letter-spacing:-.05em;
  }

  .liveCard__rail{
    margin-top:35px;
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    position:relative;
  }

  .liveCard__rail::before{
    content:"";
    position:absolute;
    left:11%;
    right:11%;
    top:15px;
    height:1px;
    background:rgba(255,255,255,.12);
  }

  .liveCard__rail > div{
    position:relative;
    z-index:2;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:7px;
  }

  .liveCard__rail span{
    width:30px;
    height:30px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:#1d1d1f;
    border:1px solid rgba(255,255,255,.12);
    color:rgba(255,255,255,.42);
    font-size:10px;
    font-weight:800;
  }

  .liveCard__rail small{
    color:rgba(255,255,255,.35);
    font-size:8px;
    white-space:nowrap;
  }

  .liveCard__rail .is-done span{
    background:#fff;
    color:#111;
  }

  .liveCard__rail .is-active span{
    background:#b88cf1;
    border-color:#b88cf1;
    color:#111;
  }

  .liveCard__rail .is-active small{color:#d8bcff}

  .liveCard__tasks{
    margin-top:34px;
    border-top:1px solid rgba(255,255,255,.12);
  }

  .liveCard__tasks article{
    min-height:72px;
    padding:14px 0;
    border-bottom:1px solid rgba(255,255,255,.12);
    display:grid;
    grid-template-columns:34px 1fr;
    gap:12px;
  }

  .liveCard__taskIcon{
    width:27px;
    height:27px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:rgba(255,255,255,.08);
    color:rgba(255,255,255,.5);
    font-size:8px;
    font-weight:800;
  }

  .liveCard__tasks strong{
    font-size:12px;
    font-weight:700;
  }

  .liveCard__tasks p{
    margin:4px 0 0;
    color:rgba(255,255,255,.42);
    font-size:10px;
    line-height:1.4;
  }

  .floatTag{
    position:absolute;
    z-index:3;
    padding:10px 13px;
    border:1px solid rgba(10,10,10,.08);
    border-radius:999px;
    background:rgba(255,255,255,.95);
    box-shadow:0 12px 32px rgba(0,0,0,.09);
    font-size:11px;
    font-weight:750;
  }

  .floatTag--one{top:12%;left:0}
  .floatTag--two{top:28%;right:-1%}
  .floatTag--three{bottom:26%;left:-2%}
  .floatTag--four{bottom:8%;right:4%}

  .statement{
    padding:clamp(92px,10vw,154px) var(--pad);
    background:#090909;
    color:#fff;
  }

  .statement__inner{
    width:min(100%,var(--max));
    margin:0 auto;
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(320px,.38fr);
    gap:clamp(48px,8vw,120px);
    align-items:end;
  }

  .statement .eyebrow{color:rgba(255,255,255,.36)}

  .statement h2{
    margin:0;
    max-width:12ch;
    font-size:clamp(54px,6vw,94px);
    line-height:.91;
    letter-spacing:-.058em;
    font-weight:720;
  }

  .statement p:last-child{
    margin:0;
    color:rgba(255,255,255,.56);
    font-size:clamp(17px,1.35vw,20px);
    line-height:1.62;
  }

  .productShot{
    padding:clamp(72px,8vw,112px) var(--pad);
    background:#f5f5f7;
  }

  .productShot__inner{
    width:min(100%,var(--max));
    margin:0 auto;
  }

  .productShot__head{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(300px,.38fr);
    gap:clamp(42px,8vw,118px);
    align-items:end;
  }

  .productShot__head h2{
    margin:0;
    font-size:clamp(48px,5.4vw,84px);
    line-height:.92;
    letter-spacing:-.058em;
    font-weight:720;
  }

  .productShot__head > p{
    margin:0;
    color:var(--muted);
    font-size:17px;
    line-height:1.58;
  }

  .productShot__frame{
    margin-top:clamp(46px,6vw,76px);
    padding:clamp(12px,1.8vw,22px);
    border-radius:30px;
    background:#fff;
    box-shadow:0 28px 70px rgba(0,0,0,.08);
    overflow:hidden;
  }

  .productShot__frame img{
    width:100%;
    height:auto;
    display:block;
    border-radius:20px;
  }

  .stages{
    padding:clamp(72px,8vw,112px) var(--pad);
    background:#fff;
  }

  .stages__inner{
    width:min(100%,var(--max));
    margin:0 auto;
  }

  .stages__head h2{
    margin:0;
    max-width:8ch;
    font-size:clamp(50px,5.5vw,84px);
    line-height:.92;
    letter-spacing:-.058em;
    font-weight:720;
  }

  .stages__grid{
    margin-top:clamp(48px,6vw,78px);
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }

  .stages__grid article{
    min-height:310px;
    padding:28px 24px;
    border-right:1px solid var(--line);
    display:flex;
    flex-direction:column;
    justify-content:space-between;
  }

  .stages__grid article:first-child{padding-left:0}
  .stages__grid article:last-child{border-right:0;padding-right:0}

  .stages__grid > article > span{
    color:#9a9a9e;
    font-size:10px;
    font-weight:800;
    letter-spacing:.12em;
  }

  .stages__grid h3{
    margin:0;
    font-size:30px;
    line-height:1;
    letter-spacing:-.045em;
  }

  .stages__grid p{
    margin:12px 0 0;
    color:var(--muted);
    font-size:14px;
    line-height:1.55;
  }

  .adaptive{
    padding:clamp(72px,8vw,112px) var(--pad);
    background:#f5f5f7;
  }

  .adaptive__inner{
    width:min(100%,var(--max));
    margin:0 auto;
  }

  .adaptive__head{
    max-width:59rem;
  }

  .adaptive__head h2{
    margin:0;
    max-width:11ch;
    font-size:clamp(50px,5.6vw,88px);
    line-height:.91;
    letter-spacing:-.06em;
    font-weight:720;
  }

  .adaptive__head > p:last-child{
    margin:24px 0 0;
    max-width:42rem;
    color:var(--muted);
    font-size:17px;
    line-height:1.6;
  }

  .adaptive__grid{
    margin-top:clamp(50px,6vw,80px);
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:16px;
  }

  .modeCard{
    min-height:430px;
    padding:30px;
    border-radius:24px;
    background:#fff;
    display:flex;
    flex-direction:column;
    overflow:hidden;
  }

  .modeCard--dark{
    background:#0a0a0a;
    color:#fff;
  }

  .modeCard > span{
    color:#8a8a8e;
    font-size:10px;
    font-weight:800;
    letter-spacing:.15em;
    text-transform:uppercase;
  }

  .modeCard--dark > span{color:rgba(255,255,255,.36)}

  .modeCard h3{
    margin:18px 0 0;
    max-width:11ch;
    font-size:clamp(35px,3.6vw,54px);
    line-height:.96;
    letter-spacing:-.052em;
    font-weight:700;
  }

  .modeCard p{
    margin:15px 0 0;
    max-width:29rem;
    color:var(--muted);
    font-size:15px;
    line-height:1.55;
  }

  .modeCard--dark p{color:rgba(255,255,255,.52)}

  .modeCard__visual{
    margin:auto auto 0;
    width:100%;
    min-height:120px;
    display:flex;
    align-items:flex-end;
    justify-content:center;
  }

  .modeCard__visual > i{
    width:28%;
    height:74px;
    margin:0 -7px;
    border:1px solid rgba(10,10,10,.12);
    border-radius:18px;
    background:#f7f7f8;
    transform:rotate(-5deg);
  }

  .modeCard__visual > i:nth-child(2){
    height:96px;
    z-index:2;
    transform:rotate(1deg);
    background:#eee8f6;
  }

  .modeCard__visual > i:nth-child(3){transform:rotate(6deg)}

  .modeCard__visual svg{
    width:85%;
    overflow:visible;
  }

  .modeCard__visual svg path{
    fill:none;
    stroke:#b88cf1;
    stroke-width:4;
    stroke-linecap:round;
    stroke-dasharray:8 10;
  }

  .modeCard__visual svg circle{
