        --hair:rgba(11,11,11,.12);
        --yellow:#f4d95f;
        --purple:#b88cf1;
        --max:1440px;
        --pad:clamp(20px,4vw,68px);
        --ease:cubic-bezier(.2,.8,.2,1);

}
.restoredInfoHeroScope *{
box-sizing:border-box
}
.restoredInfoHeroScope,
.restoredInfoHeroScope{

