        color:var(--text);

}
.restoredInfoHeroScope{
scroll-behavior:smooth
}
.restoredInfoHeroScope{

        font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        -webkit-font-smoothing:antialiased;
