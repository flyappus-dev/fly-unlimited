---
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
const siteName = "FLY Unlimited";
const contactEmail = "hello@fly-unlimited.com";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>About FLY • {siteName}</title>
    <meta
      name="description"
      content="Why FLY exists: a social marketplace built around real life, real needs, and connections that can keep moving after the first match."
    />

    <style>
      :root{
        --black:#090909;
        --white:#fff;
        --text:#111;
        --muted:#6e6e73;
        --hair:#dedee2;
        --panel:#f5f5f7;
        --yellow:#f2d35c;
        --max:1180px;
        --pad:clamp(20px,4vw,48px);
        --nav-h:64px;
        --safe-top:env(safe-area-inset-top,0px);
        --safe-bottom:env(safe-area-inset-bottom,0px);
        --ease:cubic-bezier(.2,.8,.2,1);
      }

      *{box-sizing:border-box}

      html{
        scroll-behavior:smooth;
        scroll-padding-top:calc(var(--nav-h) + var(--safe-top) + 14px);
        background:#fff;
      }

      html,body{
        margin:0;
        padding:0;
        background:#fff;
        color:var(--text);
      }

      body{
        padding-top:calc(var(--nav-h) + var(--safe-top));
        font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
        -webkit-font-smoothing:antialiased;
        text-rendering:optimizeLegibility;
        overflow-x:hidden;
      }

      a{color:inherit;text-decoration:none}

      a:focus-visible{
        outline:2px solid currentColor;
        outline-offset:4px;
      }

      [id]{
        scroll-margin-top:calc(var(--nav-h) + var(--safe-top) + 18px);
      }

      .topbar{
        position:fixed;
        inset:0 0 auto;
        z-index:100;
        min-height:calc(var(--nav-h) + var(--safe-top));
        padding-top:var(--safe-top);
        background:rgba(9,9,9,.54);
        border-bottom:1px solid rgba(255,255,255,.08);
        box-shadow:0 8px 28px rgba(0,0,0,.10);
        backdrop-filter:blur(18px) saturate(115%);
        -webkit-backdrop-filter:blur(18px) saturate(115%);
      }

      .topbarInner{
        max-width:1120px;
        min-height:var(--nav-h);
        margin:0 auto;
        padding:10px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
      }

      .brand{
        min-height:44px;
        display:flex;
        align-items:center;
      }

      .mascot{
        width:26px;
        height:26px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .nav{
        display:flex;
        align-items:center;
        gap:10px;
      }

      .navBtn{
        width:42px;
        height:42px;
        display:grid;
        place-items:center;
        border-radius:999px;
        color:rgba(255,255,255,.92);
        transition:background .18s var(--ease);
      }

      .navBtn:hover{background:rgba(255,255,255,.07)}
      .navBtn.active{background:rgba(255,255,255,.11)}

      .navIcon{
        width:18px;
        height:18px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .navBtn svg{
        width:18px;
        height:18px;
        stroke:currentColor;
        stroke-width:2.2;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      /* HERO */
      .hero{
        position:relative;
        min-height:520px;
        overflow:hidden;
        isolation:isolate;
        background:#69625c;
      }

      .heroPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        z-index:-2;
        filter:saturate(.72) contrast(.98) brightness(.86);
      }

      .hero::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-1;
        background:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.44) 44%,rgba(0,0,0,.08) 78%);
      }

      .heroInner{
        width:min(100%,var(--max));
        min-height:520px;
        margin:0 auto;
        padding:66px var(--pad);
        display:flex;
        align-items:flex-end;
      }

      .heroCopy{
        max-width:660px;
      }

      .heroKicker{
        margin:0 0 12px;
        color:rgba(255,255,255,.65);
        font-size:11px;
        font-weight:700;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .heroTitle{
        margin:0;
        color:#fff;
        font-size:clamp(54px,6.2vw,92px);
        line-height:.91;
        letter-spacing:-.055em;
        font-weight:650;
      }

      .heroLead{
        margin:18px 0 0;
        max-width:34rem;
        color:rgba(255,255,255,.80);
        font-size:clamp(18px,1.4vw,21px);
        line-height:1.5;
      }

      /* ABOUT */
      .about{
        padding:76px var(--pad) 84px;
        background:#fff;
      }

      .aboutInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .eyebrow{
        margin:0 0 13px;
        color:#86868b;
        font-size:11px;
        font-weight:700;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .aboutGrid{
        display:grid;
        grid-template-columns:minmax(0,.62fr) minmax(300px,.38fr);
        gap:clamp(36px,6vw,80px);
        align-items:start;
      }

      .aboutTitle{
        margin:0;
        max-width:10ch;
        font-size:clamp(44px,5vw,72px);
        line-height:.95;
        letter-spacing:-.05em;
        font-weight:650;
      }

      .aboutText{
        margin:0;
        color:var(--muted);
        font-size:18px;
        line-height:1.6;
      }

      .principles{
        margin-top:48px;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .principle{
        min-height:180px;
        padding:24px 22px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:flex-end;
      }

      .principle:last-child{border-right:0}

      .principleNum{
        margin-bottom:auto;
        color:#86868b;
        font-size:12px;
      }

      .principleTitle{
        margin:0;
        font-size:22px;
        line-height:1.05;
        letter-spacing:-.03em;
        font-weight:650;
      }

      .principleText{
        margin:8px 0 0;
        color:var(--muted);
        font-size:14px;
        line-height:1.5;
      }

      /* CONTACT */
      .contact{
        background:#0a0a0a;
        color:#fff;
        padding:76px var(--pad) 82px;
      }

      .contactInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .contactGrid{
        display:grid;
        grid-template-columns:minmax(0,.62fr) minmax(300px,.38fr);
        gap:clamp(36px,6vw,80px);
        align-items:start;
      }

      .contactTitle{
        margin:0;
        max-width:9ch;
        font-size:clamp(44px,5vw,72px);
        line-height:.95;
        letter-spacing:-.05em;
        font-weight:650;
      }

      .contactText{
        margin:0;
        color:rgba(255,255,255,.62);
        font-size:17px;
        line-height:1.55;
      }

      .contactLink{
        margin-top:20px;
        min-height:44px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        background:#fff;
        color:#111;
        font-size:14px;
        font-weight:600;
      }

      /* LINKS */
      .linksSection{
        padding:68px var(--pad) 76px;
        background:#fff;
      }

      .linksInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .linksTitle{
        margin:0;
        font-size:clamp(38px,4vw,58px);
        line-height:.96;
        letter-spacing:-.045em;
        font-weight:650;
      }

      .linksGrid{
        margin-top:30px;
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .resource{
        min-height:140px;
        padding:22px 18px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
      }

      .resource:last-child{border-right:0}

      .resourceLabel{
        color:#86868b;
        font-size:11px;
      }

      .resourceTitle{
        margin-top:30px;
        font-size:16px;
        font-weight:600;
      }

      /* FOOTER */
      .footer{
        padding:24px var(--pad) calc(38px + var(--safe-bottom));
        background:#fff;
        color:#86868b;
        font-size:12px;
      }

      .footerInner{
        width:min(100%,var(--max));
        margin:0 auto;
        border-top:1px solid var(--hair);
        padding-top:22px;
        display:flex;
        justify-content:space-between;
        gap:18px;
        flex-wrap:wrap;
      }

      .footerLinks{
        display:flex;
        gap:16px;
        flex-wrap:wrap;
      }

      @media(max-width:900px){
        .aboutGrid,
        .contactGrid{
          grid-template-columns:1fr;
          gap:26px;
        }

        .linksGrid{
          grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .resource:nth-child(2){
          border-right:0;
        }

        .resource:nth-child(-n+2){
          border-bottom:1px solid var(--hair);
        }
      }

      @media(max-width:720px){
        .topbar{
          background:rgba(9,9,9,.62);
          backdrop-filter:blur(16px) saturate(110%);
          -webkit-backdrop-filter:blur(16px) saturate(110%);
        }

        .nav{gap:6px}

        .navBtn{
          width:40px;
          height:40px;
        }

        .hero{
          min-height:0;
          display:flex;
          flex-direction:column;
          background:#111;
        }

        .heroPhoto{
          position:relative;
          inset:auto;
          width:100%;
          height:auto;
          object-fit:contain;
          object-position:center;
          filter:none;
          order:0;
          background:#111;
        }

        .hero::before{display:none}

        .heroInner{
          order:1;
          min-height:0;
          padding:30px 18px 36px;
          background:#111;
        }

        .heroTitle{
          font-size:50px;
        }

        .heroLead{
          font-size:16px;
        }

        .about,
        .contact,
        .linksSection{
          padding-left:18px;
          padding-right:18px;
        }

        .about{
          padding-top:58px;
          padding-bottom:64px;
        }

        .aboutTitle,
        .contactTitle{
          font-size:44px;
        }

        .aboutText{
          font-size:16px;
        }

        .principles{
          grid-template-columns:1fr;
          margin-top:34px;
        }

        .principle{
          min-height:auto;
          padding:22px 0;
          border-right:0;
          border-bottom:1px solid var(--hair);
        }

        .principle:last-child{border-bottom:0}

        .principleNum{
          margin-bottom:24px;
        }

        .contact{
          padding-top:60px;
          padding-bottom:66px;
        }

        .contactLink{
          width:100%;
        }

        .linksSection{
          padding-top:58px;
          padding-bottom:62px;
        }

        .linksGrid{
          grid-template-columns:1fr;
        }

        .resource{
          min-height:auto;
          padding:20px 0;
          border-right:0;
          border-bottom:1px solid var(--hair);
        }

        .resource:last-child{border-bottom:0}

        .resourceTitle{
          margin-top:20px;
        }

        .footer{
          padding-left:18px;
          padding-right:18px;
        }
      }

      @media(max-width:390px){
        .topbarInner{
          padding-left:14px;
          padding-right:14px;
        }
      }

      @media(prefers-reduced-motion:reduce){
        *{
          scroll-behavior:auto !important;
          animation:none !important;
          transition:none !important;
        }
      }

      /* ===== FLY INFO BANNER RESTORE V2 — EXACT PRE-PHASE10 ===== */
      .restoredInfoHeroScope{
        width:100%;
        display:block;
        overflow:hidden;
      }

.restoredInfoHeroScope{

        --black:#090909;
        --white:#f8f6f1;
        --paper:#eee9e0;
        --text:#0b0b0b;
