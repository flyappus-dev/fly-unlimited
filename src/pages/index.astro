---
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
const siteName = "FLY Unlimited";
const contactEmail = "hello@fly-unlimited.com";
const appStoreUrl = "https://apps.apple.com/us/app/fly-unlimited/id6758623880";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FLY Unlimited — Ask. Connect. Repeat.</title>
    <meta
      name="description"
      content="FLY is a social marketplace where you can ask for what you need, connect with what fits, and carry the FLY from connection to completion."
    />

    <style>
      :root{
        --black:#090909;
        --white:#f8f6f1;
        --paper:#f0ece4;
        --purple:#b88cf1;
        --mint:#baf0c3;
        --yellow:#f4d95f;
        --coral:#ee8378;
        --blue:#91b8ec;

        --text:#0b0b0b;
        --muted:rgba(11,11,11,.62);
        --hair:rgba(11,11,11,.12);
        --max:1440px;
        --pad:clamp(20px,4vw,68px);
        --ease:cubic-bezier(.2,.8,.2,1);
      }

      *{box-sizing:border-box}

      html{
        scroll-behavior:smooth;
        background:var(--black);
      }

      html,body{
        margin:0;
        padding:0;
      }

      body{
        background:var(--white);
        color:var(--text);
        font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        -webkit-font-smoothing:antialiased;
        text-rendering:optimizeLegibility;
        overflow-x:hidden;
      }

      a{
        color:inherit;
        text-decoration:none;
      }

      a:focus-visible{
        outline:2px solid currentColor;
        outline-offset:4px;
      }

      .display{
        margin:0;
        font-family:"Arial Narrow","Helvetica Neue Condensed Bold","Arial",sans-serif;
        font-stretch:condensed;
        font-weight:900;
        text-transform:uppercase;
        letter-spacing:-.062em;
        line-height:.84;
      }

      /* ===== FLY NAV — SAME SYSTEM AS HOW IT WORKS ===== */
      .topbar{
        position:fixed;
        top:0;
        left:0;
        right:0;
        z-index:80;
        background:rgba(9,9,9,.54);
        border-bottom:1px solid rgba(255,255,255,.08);
        box-shadow:0 8px 28px rgba(0,0,0,.12);
        backdrop-filter:blur(18px) saturate(115%);
        -webkit-backdrop-filter:blur(18px) saturate(115%);
      }

      .topbarInner{
        max-width:1120px;
        margin:0 auto;
        padding:10px 18px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:14px;
      }

      .brand{
        display:flex;
        align-items:center;
        min-height:44px;
      }

      .mascot{
        width:26px;
        height:26px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .nav{
        display:flex;
        align-items:center;
        gap:10px;
      }

      .navBtn{
        width:42px;
        height:42px;
        display:grid;
        place-items:center;
        border-radius:999px;
        color:rgba(255,255,255,.92);
        transition:background .18s var(--ease),color .18s var(--ease);
      }

      .navBtn:hover{
        background:rgba(255,255,255,.07);
        color:#fff;
      }

      .navBtn.active{
        background:rgba(255,255,255,.11);
        color:#fff;
      }

      .navIcon{
        width:18px;
        height:18px;
        display:block;
        object-fit:contain;
        filter:brightness(0) invert(1);
      }

      .navBtn svg{
        width:18px;
        height:18px;
        display:block;
        stroke:currentColor;
        fill:none;
        stroke-width:2.2;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      /* ===== HERO ===== */
      .hero{
        position:relative;
        min-height:100svh;
        overflow:hidden;
        isolation:isolate;
        background:#8b8179;
      }

      .heroPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:58% center;
        z-index:-3;
        filter:saturate(.72) contrast(.96) brightness(.91) sepia(.05);
      }

      .hero::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-2;
        background:
          linear-gradient(
            90deg,
            rgba(6,6,6,.76) 0%,
            rgba(6,6,6,.54) 34%,
            rgba(6,6,6,.20) 61%,
            rgba(6,6,6,.03) 82%,
            rgba(6,6,6,0) 100%
          ),
          linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.16));
      }

      .heroInner{
        width:min(100%,var(--max));
        min-height:100svh;
        margin:0 auto;
        padding:clamp(118px,12vw,164px) var(--pad) clamp(70px,7vw,100px);
        display:flex;
        align-items:center;
      }

      .heroCopy{
        width:min(100%,790px);
      }

      .eyebrow{
        margin:0 0 16px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(255,255,255,.64);
      }

      .heroTitle{
        max-width:7.5ch;
        font-size:clamp(66px,8vw,148px);
        color:#f8f1e7;
        text-shadow:0 2px 28px rgba(0,0,0,.18);
      }

      .heroTitle .accent{
        color:var(--yellow);
      }

      .heroSub{
        margin:24px 0 0;
        max-width:34rem;
        color:rgba(255,255,255,.91);
        font-size:clamp(14px,1.12vw,17px);
        font-weight:820;
        line-height:1.5;
        letter-spacing:.14em;
        text-transform:uppercase;
      }

      .heroBody{
        margin:20px 0 0;
        max-width:32rem;
        color:rgba(255,255,255,.72);
        font-size:clamp(17px,1.18vw,20px);
        line-height:1.58;
      }

      .heroActions{
        margin-top:30px;
        display:flex;
        gap:10px;
        flex-wrap:wrap;
      }

      .cta{
        min-height:46px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        border:1px solid rgba(255,255,255,.34);
        font-size:13px;
        font-weight:780;
        transition:transform .18s var(--ease),background .18s var(--ease);
      }

      .cta:hover{
        transform:translateY(-1px);
      }

      .cta.primary{
        background:#fff;
        color:#111;
        border-color:#fff;
      }

      .cta.secondary{
        background:rgba(0,0,0,.14);
        color:#fff;
        backdrop-filter:blur(10px);
      }

      /* ===== SIMPLE BRAND STATEMENT ===== */
      .statement{
        padding:clamp(70px,7vw,106px) var(--pad);
        background:var(--white);
      }

      .statementInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .statementTop{
        display:grid;
        grid-template-columns:minmax(0,.67fr) minmax(310px,.33fr);
        gap:52px;
        align-items:end;
      }

      .statementKicker{
        margin:0 0 14px;
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
        color:rgba(11,11,11,.44);
      }

      .statementTitle{
        margin:0;
        max-width:10ch;
        font-size:clamp(46px,5.3vw,88px);
        line-height:.92;
        letter-spacing:-.052em;
        font-weight:850;
      }

      .statementBody{
        margin:0;
        max-width:34rem;
        color:var(--muted);
        font-size:clamp(17px,1.15vw,20px);
        line-height:1.6;
      }

      .statementRail{
        margin-top:clamp(34px,4vw,52px);
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        border-top:1px solid var(--hair);
        border-bottom:1px solid var(--hair);
      }

      .statementItem{
        min-height:160px;
        padding:24px 22px 26px;
        border-right:1px solid var(--hair);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
      }

      .statementItem:last-child{
        border-right:0;
      }

      .statementNum{
        font-size:10px;
        font-weight:800;
        letter-spacing:.18em;
        color:rgba(11,11,11,.36);
      }

      .statementWord{
        margin:0;
        font-family:"Arial Narrow","Helvetica Neue Condensed Bold","Arial",sans-serif;
        font-stretch:condensed;
        font-size:clamp(40px,4vw,70px);
        line-height:.86;
        letter-spacing:-.06em;
        text-transform:uppercase;
        font-weight:900;
      }

      .statementItem:nth-child(1) .statementWord{color:#9674ce}
      .statementItem:nth-child(2) .statementWord{color:#6d9f77}
      .statementItem:nth-child(3) .statementWord{color:#c8a53b}

      .statementText{
        margin:12px 0 0;
        max-width:18rem;
        color:var(--muted);
        font-size:14.5px;
        line-height:1.52;
      }

      /* ===== CAMPAIGN CHAPTERS ===== */
      .campaign{
        position:relative;
        min-height:clamp(500px,51vw,650px);
        overflow:hidden;
        isolation:isolate;
        background:#7e776f;
      }

      .campaignPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:var(--photo-position,55% center);
        z-index:-3;
        filter:saturate(.7) contrast(.96) brightness(.91) sepia(.045);
      }

      .campaign::before{
        content:"";
        position:absolute;
        inset:0;
        z-index:-2;
        background:
          linear-gradient(
            90deg,
            rgba(7,7,7,.70) 0%,
            rgba(7,7,7,.47) 34%,
            rgba(7,7,7,.19) 58%,
            rgba(7,7,7,.04) 78%,
            rgba(7,7,7,0) 100%
          ),
          linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.11));
      }

      .campaignInner{
        width:min(100%,var(--max));
        min-height:inherit;
        margin:0 auto;
        padding:clamp(52px,6vw,88px) var(--pad) clamp(54px,6.2vw,92px);
        display:flex;
        align-items:flex-end;
      }

      .campaignCopy{
        width:min(100%,760px);
      }

      .campaignKicker{
        margin:0 0 14px;
        color:rgba(255,255,255,.62);
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
      }

      .campaignTitle{
        max-width:7.4ch;
        font-size:clamp(58px,7.2vw,128px);
        text-shadow:0 2px 24px rgba(0,0,0,.18);
      }

      .campaignSub{
        margin:22px 0 0;
        max-width:35rem;
        color:rgba(255,255,255,.9);
        font-size:clamp(13px,1.05vw,16px);
        line-height:1.48;
        letter-spacing:.15em;
        font-weight:820;
        text-transform:uppercase;
      }

      .campaignLink{
        margin-top:24px;
        display:inline-flex;
        align-items:center;
        gap:8px;
        color:rgba(255,255,255,.86);
        font-size:13px;
        font-weight:760;
      }

      .campaignLink svg{
        width:15px;
        height:15px;
        stroke:currentColor;
        stroke-width:2.1;
        fill:none;
        stroke-linecap:round;
        stroke-linejoin:round;
      }

      .ask{--photo-position:54% center}
      .marketplace{--photo-position:55% center}
      .livetime{--photo-position:58% center}

      .ask .campaignTitle{color:var(--purple)}
      .marketplace .campaignTitle{color:var(--mint)}
      .livetime .campaignTitle{color:var(--blue)}

      /* ===== DARK PRODUCT TEASER ===== */
      .difference{
        padding:clamp(72px,7vw,108px) var(--pad);
        background:#0a0a0a;
        color:#fff;
      }

      .differenceInner{
        width:min(100%,var(--max));
        margin:0 auto;
      }

      .differenceTop{
        display:grid;
        grid-template-columns:minmax(0,.67fr) minmax(310px,.33fr);
        gap:52px;
        align-items:end;
      }

      .differenceKicker{
        margin:0 0 14px;
        color:rgba(255,255,255,.46);
        font-size:11px;
        font-weight:800;
        letter-spacing:.18em;
        text-transform:uppercase;
      }

      .differenceTitle{
        margin:0;
        max-width:9ch;
        font-size:clamp(46px,5.2vw,86px);
        line-height:.92;
        letter-spacing:-.052em;
        font-weight:850;
      }

      .differenceBody{
        margin:0;
        max-width:34rem;
        color:rgba(255,255,255,.62);
        font-size:clamp(17px,1.15vw,19px);
        line-height:1.6;
      }

      .differenceRail{
        margin-top:clamp(42px,5vw,64px);
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        border-top:1px solid rgba(255,255,255,.14);
        border-bottom:1px solid rgba(255,255,255,.14);
      }

      .differenceItem{
        min-height:160px;
        padding:24px 22px 26px;
        border-right:1px solid rgba(255,255,255,.14);
        display:flex;
        flex-direction:column;
        justify-content:flex-end;
      }

      .differenceItem:last-child{
        border-right:0;
      }

      .differenceLabel{
        margin:0;
        font-size:clamp(23px,2.2vw,34px);
        line-height:1;
        letter-spacing:-.045em;
        font-weight:850;
      }

      .differenceText{
        margin:12px 0 0;
        max-width:18rem;
        color:rgba(255,255,255,.55);
        font-size:14.5px;
        line-height:1.52;
      }

      .differenceCta{
        margin-top:28px;
        display:inline-flex;
        align-items:center;
        gap:8px;
        color:#fff;
        font-size:13px;
        font-weight:780;
      }

      /* ===== CLOSE ===== */
      .closing{
        position:relative;
        min-height:clamp(560px,58vw,760px);
        overflow:hidden;
        isolation:isolate;
        display:grid;
        place-items:center;
        background:#29241f;
      }

      .closingPhoto{
        position:absolute;
        inset:0;
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
        z-index:-2;
        filter:saturate(.62) contrast(.96) brightness(.74) sepia(.04);
      }

      .closing::after{
        content:"";
        position:absolute;
        inset:0;
        z-index:-1;
        background:linear-gradient(180deg,rgba(0,0,0,.10),rgba(0,0,0,.42));
      }

      .closingContent{
        padding:70px 20px;
        text-align:center;
        color:#fff;
      }

      .closingLogo{
        width:clamp(150px,18vw,290px);
        height:auto;
        margin:0 auto;
        display:block;
        filter:brightness(0) invert(1);
      }

      .closingTitle{
        margin:18px 0 0;
        font-size:clamp(27px,2.7vw,42px);
        font-weight:450;
        letter-spacing:-.035em;
      }

      .closingSub{
        margin:10px auto 0;
        max-width:28rem;
        color:rgba(255,255,255,.72);
        font-size:14px;
        line-height:1.5;
      }

      .closingCta{
        margin-top:28px;
        min-height:46px;
        padding:0 18px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        background:#fff;
        color:#111;
        font-size:13px;
        font-weight:800;
      }

      /* ===== FOOTER ===== */
      .footer{
        padding:25px var(--pad) 38px;
        background:#090909;
        color:rgba(255,255,255,.46);
        font-size:12px;
      }

      .footerInner{
        width:min(100%,var(--max));
        margin:0 auto;
        display:flex;
        justify-content:space-between;
        gap:20px;
        flex-wrap:wrap;
      }

      .footerLinks{
        display:flex;
        gap:16px;
        flex-wrap:wrap;
      }

      @media(max-width:900px){
        .statementTop,
        .differenceTop{
          grid-template-columns:1fr;
          gap:20px;
        }

        .statementRail,
        .differenceRail{
          grid-template-columns:1fr;
        }

        .statementItem,
        .differenceItem{
          min-height:170px;
          border-right:0;
          border-bottom:1px solid var(--hair);
        }

        .differenceItem{
          border-bottom-color:rgba(255,255,255,.14);
        }
      }

      @media(max-width:720px){
        :root{--pad:18px}

        .topbar{
          background:rgba(9,9,9,.62);
          backdrop-filter:blur(16px) saturate(110%);
          -webkit-backdrop-filter:blur(16px) saturate(110%);
        }

        .heroPhoto{
          object-position:62% center;
        }

        .heroInner{
          padding:116px 18px 58px;
          align-items:flex-end;
        }

        .heroTitle{
          max-width:7ch;
          font-size:clamp(58px,17vw,86px);
        }

        .heroBody{
          font-size:16px;
        }

        .heroActions{
          width:100%;
        }

        .cta{
          flex:1 1 100%;
        }

        .statement,
        .difference{
          padding:68px 18px 76px;
        }

        .campaign{
          min-height:680px;
        }

        .campaignPhoto{
          object-position:60% center;
        }

        .campaignInner{
          min-height:680px;
          padding:52px 18px 48px;
        }

        .campaignTitle{
          max-width:7ch;
          font-size:clamp(52px,16vw,78px);
        }

        .closing{
          min-height:680px;
        }

        .closingPhoto{
          object-position:56% center;
        }

        .footer{
          padding-left:18px;
          padding-right:18px;
        }
      }

      @media(prefers-reduced-motion:reduce){
        html{scroll-behavior:auto}
        *{transition:none!important}
      }


      /* ===== PHASE 7 — RESPONSIVE / NAV FOUNDATION ===== */
      :root{ --fly-nav-h:64px; }

      body{
        padding-top:var(--fly-nav-h) !important;
      }

      .topbar{
        min-height:var(--fly-nav-h);
      }

      .campaign__photo,
      .heroPhoto,
      .askBannerPhoto,
      .livePhoto,
      .closing__photo,
      .finalPhoto{
        transform:none !important;
      }

      @media(max-width:900px){
        .campaign,
        .hero,
        .askBanner,
        .liveBanner,
        .live{
          min-height:0 !important;
          height:auto !important;
          display:flex !important;
          flex-direction:column !important;
          background:#111 !important;
          overflow:hidden !important;
        }

        .campaign__photo,
        .heroPhoto,
        .askBannerPhoto,
        .liveBannerPhoto,
        .livePhoto{
          position:relative !important;
          inset:auto !important;
          order:0 !important;
          width:100% !important;
          height:auto !important;
          aspect-ratio:auto !important;
          object-fit:contain !important;
          object-position:center !important;
          display:block !important;
          filter:none !important;
          transform:none !important;
          background:#111 !important;
        }

        .campaign::before,
        .hero::before,
        .askBanner::before,
        .liveBanner::before,
        .live::before{
          display:none !important;
        }

        .campaign__inner,
        .heroInner,
        .askBannerInner,
        .liveBannerInner,
        .liveInner{
          order:1 !important;
          min-height:0 !important;
          height:auto !important;
          padding:34px 22px 40px !important;
          display:block !important;
          background:#111 !important;
        }

        .campaign__copy,
        .heroCopy,
        .askBannerCopy,
        .liveBannerCopy,
        .liveCopy{
          width:100% !important;
          max-width:680px !important;
          padding:0 !important;
          margin:0 !important;
          color:#fff !important;
        }

        .campaign__body,
        .campaign__kicker,
        .heroText,
        .heroSub,
        .askBannerText,
        .liveBannerText,
        .liveText{
          color:rgba(255,255,255,.76) !important;
        }

        .campaign__title,
        .heroTitle,
        .askBannerTitle,
        .liveBannerTitle,
        .liveTitle{
          max-width:10ch !important;
        }
      }

      @media(max-width:560px){
        .campaign__inner,
        .heroInner,
        .askBannerInner,
        .liveBannerInner,
        .liveInner{
          padding:28px 18px 34px !important;
        }

        .campaign__title,
        .heroTitle,
        .askBannerTitle,
        .liveBannerTitle,
        .liveTitle{
          font-size:clamp(44px,13vw,64px) !important;
          line-height:.92 !important;
        }

        .campaign__sub,
        .campaign__body,
        .heroText,
        .heroSub,
        .askBannerText,
        .liveText{
          font-size:16px !important;
          line-height:1.5 !important;
        }

        .heroActions{
          width:100%;
        }

        .heroActions a,
        .heroBtn,
        .heroCta,
        .askBannerLink{
          width:100% !important;
          justify-content:center !important;
        }
      }



      /* ===== PHASE 9 — PROFESSIONAL COMPANY POLISH ===== */
      :root{
        --fly-nav-h:64px;
        --fly-safe-top:env(safe-area-inset-top, 0px);
        --fly-safe-bottom:env(safe-area-inset-bottom, 0px);
      }

      html{
        scroll-padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top) + 14px);
      }

      body{
        padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top)) !important;
      }

      .topbar{
        min-height:calc(var(--fly-nav-h) + var(--fly-safe-top));
        padding-top:var(--fly-safe-top);
      }

      [id]{
        scroll-margin-top:calc(var(--fly-nav-h) + var(--fly-safe-top) + 18px);
      }

      button,
      a{
        -webkit-tap-highlight-color:transparent;
      }

      .navBtn{
        min-width:42px;
        min-height:42px;
      }

      /* Keep the site sharp and restrained on large screens. */
      main p{
        text-wrap:pretty;
      }

      h1,h2,h3{
        text-wrap:balance;
      }

      .heroActions a,
      .heroBtn,
      .heroCta,
      .cta,
      .finalBtn,
      .closingBtn,
      .askBannerLink{
        min-height:44px;
        transition:
          transform .18s var(--ease, cubic-bezier(.2,.8,.2,1)),
          opacity .18s ease,
          background .18s ease,
          border-color .18s ease;
      }

      @media(hover:hover){
        .heroActions a:hover,
        .heroBtn:hover,
        .heroCta:hover,
        .cta:hover,
        .finalBtn:hover,
        .closingBtn:hover,
        .askBannerLink:hover{
          transform:translateY(-1px);
        }
      }

      /* Better tablet rhythm — do not let desktop compositions feel cramped. */
      @media(min-width:721px) and (max-width:1100px){
        :root{
          --pad:clamp(28px,4vw,44px);
        }

        .topbarInner{
          padding-left:24px;
          padding-right:24px;
        }
      }

      /* iPhone / app-webview finishing pass. */
      @media(max-width:720px){
        body{
          padding-top:calc(var(--fly-nav-h) + var(--fly-safe-top)) !important;
        }

        .topbarInner{
          min-height:var(--fly-nav-h);
          padding-left:18px;
          padding-right:18px;
        }

        .nav{
          gap:6px;
        }

        .navBtn{
          width:40px;
          height:40px;
        }

        .footer{
          padding-bottom:calc(34px + var(--fly-safe-bottom)) !important;
        }

        .footerInner{
          align-items:flex-start !important;
        }

        .footerLinks{
          row-gap:10px !important;
        }
      }

      @media(max-width:390px){
        .topbarInner{
          padding-left:14px;
          padding-right:14px;
        }
      }

      @media(prefers-reduced-motion:reduce){
        *{
          scroll-behavior:auto !important;
          animation:none !important;
          transition:none !important;
        }
      }


      /* ===== PHASE 9 — HOMEPAGE FINISHING ===== */
      .loop,
      .benefits,
      .brandProof,
      .guide,
      .difference,
      .what{
        background:#fff !important;
      }

      @media(max-width:720px){
        .campaign__copy,
        .heroCopy{
          max-width:34rem !important;
        }
      }


      /* ===== FLY NAV STATE V1 — WHITE AT TOP / DARK GLASS ON SCROLL ===== */
      .topbar{
        background:#fff !important;
        border-bottom:1px solid rgba(11,11,11,.08) !important;
        box-shadow:none !important;
        backdrop-filter:none !important;
        -webkit-backdrop-filter:none !important;
        transition:
          background .22s ease,
          border-color .22s ease,
          box-shadow .22s ease,
          backdrop-filter .22s ease;
      }

      .topbar .mascot,
      .topbar .navIcon{
        filter:none !important;
        transition:filter .20s ease;
      }

      .topbar .navBtn{
        color:rgba(11,11,11,.88) !important;
        transition:
          background .18s ease,
          color .18s ease;
      }

      .topbar .navBtn:hover{
        background:rgba(0,0,0,.05) !important;
        color:#111 !important;
      }

      .topbar .navBtn.active{
        background:rgba(0,0,0,.08) !important;
        color:#111 !important;
      }

      .topbar.is-scrolled{
        background:rgba(9,9,9,.80) !important;
        border-bottom-color:rgba(255,255,255,.08) !important;
        box-shadow:0 8px 28px rgba(0,0,0,.14) !important;
        backdrop-filter:blur(18px) saturate(115%) !important;
        -webkit-backdrop-filter:blur(18px) saturate(115%) !important;
      }

      .topbar.is-scrolled .mascot,
      .topbar.is-scrolled .navIcon{
        filter:brightness(0) invert(1) !important;
      }

      .topbar.is-scrolled .navBtn{
        color:rgba(255,255,255,.92) !important;
      }

      .topbar.is-scrolled .navBtn:hover{
        background:rgba(255,255,255,.07) !important;
        color:#fff !important;
      }

      .topbar.is-scrolled .navBtn.active{
        background:rgba(255,255,255,.11) !important;
        color:#fff !important;
      }

      @media(max-width:720px){
        .topbar.is-scrolled{
          background:rgba(9,9,9,.84) !important;
          backdrop-filter:blur(16px) saturate(110%) !important;
          -webkit-backdrop-filter:blur(16px) saturate(110%) !important;
        }
      }

</style>
