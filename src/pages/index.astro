<script is:inline>
      (() => {
        const bar = document.querySelector(".topbar");
        if (!bar) return;

        let ticking = false;

        const syncNavState = () => {
          const trigger = Math.max(40, bar.offsetHeight - 8);
          bar.classList.toggle("is-scrolled", window.scrollY >= trigger);
        };

        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            syncNavState();
            ticking = false;
          });
        };

        syncNavState();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", syncNavState, { passive: true });
      })();
    </script>

